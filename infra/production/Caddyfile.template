# Frontman Production Caddyfile
#
# This template shows the Caddy configuration for the Frontman API server and
# PlayGithub sandbox hosts.
# The deploy.sh script dynamically rewrites /etc/caddy/Caddyfile with the
# correct port (4000 for blue, 4001 for green) on each deployment.
#
# Caddy handles TLS automatically via Let's Encrypt.
# DNS A record for api.frontman.sh must point to this server. Use Cloudflare
# DNS-only mode (grey cloud) so Caddy can handle ACME challenges.
#
# The wildcard *.playgithub.com record is proxied through Cloudflare. Caddy uses
# an internal origin cert for HTTPS wildcard traffic; use Cloudflare SSL mode
# Full, or replace this with a Cloudflare Origin CA cert for Full (strict).

api.frontman.sh {
    reverse_proxy localhost:{PORT}
}

http://*.playgithub.com {
    reverse_proxy localhost:{PORT}
}

https://*.playgithub.com {
    tls internal
    reverse_proxy localhost:{PORT}
}
