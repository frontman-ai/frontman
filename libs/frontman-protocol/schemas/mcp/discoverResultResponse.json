{
  "type": "object",
  "properties": {
    "jsonrpc": {
      "type": "string",
      "const": "2.0"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "resultType": {
          "type": "string"
        },
        "supportedVersions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "completions": {
              "type": "object",
              "additionalProperties": true
            },
            "experimental": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "extensions": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              },
              "propertyNames": {
                "allOf": [
                  {
                    "pattern": "^(?:[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\/)?(?:[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)?$(?![\\s\\S])"
                  },
                  {
                    "pattern": "/"
                  }
                ]
              }
            },
            "logging": {
              "type": "object",
              "additionalProperties": true
            },
            "prompts": {
              "type": "object",
              "properties": {
                "listChanged": {
                  "type": "boolean"
                }
              }
            },
            "resources": {
              "type": "object",
              "properties": {
                "listChanged": {
                  "type": "boolean"
                },
                "subscribe": {
                  "type": "boolean"
                }
              }
            },
            "tools": {
              "type": "object",
              "properties": {
                "listChanged": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "_meta": {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 64,
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^(?:[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\/)?(?:[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)?$(?![\\s\\S])"
              },
              {
                "not": {
                  "enum": [
                    "traceparent",
                    "tracestate",
                    "baggage"
                  ]
                }
              }
            ]
          },
          "properties": {
            "io.modelcontextprotocol/serverInfo": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "websiteUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "icons": {
                  "items": {
                    "type": "object",
                    "properties": {
                      "src": {
                        "type": "string",
                        "format": "uri"
                      },
                      "mimeType": {
                        "type": "string"
                      },
                      "sizes": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "theme": {
                        "enum": [
                          "dark",
                          "light"
                        ]
                      }
                    },
                    "required": [
                      "src"
                    ]
                  },
                  "type": "array"
                }
              },
              "required": [
                "name",
                "version"
              ]
            }
          }
        },
        "instructions": {
          "type": "string"
        },
        "ttlMs": {
          "type": "integer",
          "minimum": 0
        },
        "cacheScope": {
          "enum": [
            "private",
            "public"
          ]
        }
      },
      "required": [
        "resultType",
        "supportedVersions",
        "capabilities",
        "ttlMs",
        "cacheScope"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "result"
  ]
}
