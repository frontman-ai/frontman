{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri"
    },
    "icons": {
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "format": "uri"
          },
          "mimeType": {
            "type": "string"
          },
          "sizes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "theme": {
            "enum": [
              "dark",
              "light"
            ]
          }
        },
        "required": [
          "src"
        ]
      },
      "type": "array"
    }
  },
  "required": [
    "name",
    "version"
  ]
}
