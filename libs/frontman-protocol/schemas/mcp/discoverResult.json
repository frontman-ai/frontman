{
  "type": "object",
  "properties": {
    "resultType": {
      "type": "string",
      "const": "complete"
    },
    "supportedVersions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "object",
          "properties": {
            "listChanged": {
              "type": "boolean"
            }
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {}
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\/(?:[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)?$"
          }
        }
      }
    },
    "instructions": {
      "type": "string"
    },
    "ttlMs": {
      "type": "number",
      "multipleOf": 1,
      "minimum": 0
    },
    "cacheScope": {
      "enum": [
        "public",
        "private"
      ]
    },
    "_meta": {
      "type": "object",
      "properties": {
        "io.modelcontextprotocol/serverInfo": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ]
        }
      }
    }
  },
  "required": [
    "resultType",
    "supportedVersions",
    "capabilities",
    "ttlMs",
    "cacheScope"
  ]
}
