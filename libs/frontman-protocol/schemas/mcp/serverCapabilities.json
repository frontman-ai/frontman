{
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "completions": {
      "type": "object",
      "additionalProperties": true
    },
    "experimental": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^(?:[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\/)?(?:[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)?$(?![\\s\\S])"
          },
          {
            "pattern": "/"
          }
        ]
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": true
    },
    "prompts": {
      "type": "object",
      "properties": {
        "listChanged": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "listChanged": {
          "type": "boolean"
        },
        "subscribe": {
          "type": "boolean"
        }
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "listChanged": {
          "type": "boolean"
        }
      }
    }
  }
}
