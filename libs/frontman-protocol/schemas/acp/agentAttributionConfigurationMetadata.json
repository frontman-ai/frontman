{
  "type": "object",
  "properties": {
    "agentAttribution": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "version"
      ]
    },
    "agents": {
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "required": [
          "id",
          "name",
          "displayName",
          "description",
          "color"
        ]
      },
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Frontman runtime validation also requires unique id fields"
    },
    "defaultAgentId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "agentAttribution",
    "agents",
    "defaultAgentId"
  ]
}
