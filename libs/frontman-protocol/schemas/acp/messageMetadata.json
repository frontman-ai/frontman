{
  "type": "object",
  "properties": {
    "frontman.dev/agentId": {
      "type": "string",
      "minLength": 1
    },
    "frontman.dev/timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
      "format": "date-time"
    }
  },
  "required": [
    "frontman.dev/agentId",
    "frontman.dev/timestamp"
  ]
}
