layout {
    pane split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="rescript" {
                command "make"
                args "rescript-watch"
            }
            pane name="server" {
                command "make"
                args "dev-server"
            }
        }
        pane split_direction="horizontal" {
            pane name="client" {
                command "make"
                args "dev-client"
            }
            pane name="nextjs" {
                command "bash"
                args "-c" "echo 'Waiting for ReScript compiler...' && while ! tail -1 lib/bs/.compiler.log 2>/dev/null | grep -q '^#Done'; do sleep 1; done && echo 'ReScript ready, starting Next.js...' && make dev-nextjs"
            }
        }
    }
}
