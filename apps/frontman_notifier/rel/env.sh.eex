#!/bin/sh

shared_env="${FRONTMAN_SHARED_ENV:-/opt/frontman/shared/discord.env}"

if [ -r "$shared_env" ]; then
  set -a
  . "$shared_env"
  set +a
elif [ -z "${DISCORD_TASK_SUMMARIES_WEBHOOK_URL:-}" ]; then
  echo "ERROR: Missing shared environment file and DISCORD_TASK_SUMMARIES_WEBHOOK_URL is unset: $shared_env" >&2
  exit 1
fi

unset shared_env
