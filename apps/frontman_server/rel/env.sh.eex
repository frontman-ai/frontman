#!/bin/sh

shared_env="${FRONTMAN_SHARED_ENV:-/opt/frontman/shared/discord.env}"
variable="DISCORD_TASK_SUMMARIES_WEBHOOK_URL"

if [ -r "$shared_env" ]; then
  assignment=$(grep "^${variable}=" "$shared_env" | tail -n 1)
  value=${assignment#*=}
  if [ -z "$value" ] || [ "$value" = "CHANGE_ME" ]; then
    echo "ERROR: $variable is not configured in $shared_env" >&2
    exit 1
  fi
  export "$assignment"
elif [ -z "${DISCORD_TASK_SUMMARIES_WEBHOOK_URL:-}" ]; then
  echo "ERROR: Missing shared environment file and $variable is unset: $shared_env" >&2
  exit 1
fi

unset assignment shared_env value variable
