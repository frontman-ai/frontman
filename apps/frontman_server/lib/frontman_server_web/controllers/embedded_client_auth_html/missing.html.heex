<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="mx-auto max-w-lg space-y-4 text-center">
    <h1 class="font-headings text-3xl font-bold tracking-tight text-base-content">
      Authentication complete
    </h1>
    <p class="text-sm leading-6 text-base-content/70">
      You may close this window.
    </p>
  </section>
</Layouts.app>
