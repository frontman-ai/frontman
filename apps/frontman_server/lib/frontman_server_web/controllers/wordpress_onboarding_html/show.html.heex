<Layouts.app flash={@flash} current_scope={@current_scope} focused>
  <Layouts.connection title="Connect your WordPress site" step={3}>
    <:intro>
      Follow these steps to connect your site to your AI assistant.
    </:intro>

    <ol class="space-y-10">
      <li class="flex gap-4 sm:gap-6">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-violet-400/15 font-semibold text-violet-200">1</span>
        <div class="min-w-0 flex-1">
          <h2 class="font-headings text-xl font-semibold text-white">Install Frontman</h2>
          <p class="mt-2 leading-7 text-zinc-300">{Enum.at(@steps, 0)}</p>
          <a
            id="install-plugin"
            href="https://wordpress.org/plugins/frontman-agentic-ai-editor/"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block font-semibold text-violet-200 underline underline-offset-4 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-300"
          >Open the Frontman plugin page
          <span class="text-sm font-normal">(opens in a new tab)</span></a>
          <p class="mt-2 text-sm leading-6 text-zinc-400">
            If Frontman is already active on your site, continue to the next step.
          </p>
        </div>
      </li>
      <li class="flex gap-4 sm:gap-6">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-violet-400/15 font-semibold text-violet-200">2</span>
        <div class="min-w-0 flex-1">
          <h2 class="font-headings text-xl font-semibold text-white">Open Frontman</h2>
          <p class="mt-2 leading-7 text-zinc-300">{Enum.at(@steps, 1)}</p>
          <img
            src="/images/wordpress-onboarding/wordpress-menu.png"
            width="320"
            height="550"
            loading="lazy"
            alt="WordPress Dashboard menu with Frontman near the bottom"
            class="mt-5 h-auto w-full max-w-40 rounded-lg"
          />
        </div>
      </li>
      <li id="frontman-sign-in" class="flex gap-4 sm:gap-6">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-violet-400/15 font-semibold text-violet-200">3</span>
        <div class="min-w-0 flex-1">
          <h2 class="font-headings text-xl font-semibold text-white">Sign in to Frontman</h2>
          <p class="mt-2 leading-7 text-zinc-300">{Enum.at(@steps, 2)}</p>
          <p class="mt-3 text-sm leading-6 text-zinc-400">
            The account on this page is <strong class="break-all text-white">{@current_scope.user.email}</strong>.
          </p>
        </div>
      </li>
      <li class="flex gap-4 sm:gap-6">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-violet-400/15 font-semibold text-violet-200">4</span>
        <div class="min-w-0 flex-1">
          <h2 class="font-headings text-xl font-semibold text-white">Connect your site</h2>
          <p class="mt-2 leading-7 text-zinc-300">{Enum.at(@steps, 3)}</p>
          <img
            src="/images/wordpress-onboarding/connect-assistant.png"
            width="896"
            height="324"
            loading="lazy"
            alt="First-use window with the Connect an AI assistant button"
            class="mt-5 h-auto w-full max-w-lg rounded-lg"
          />
          <p class="mt-3 leading-7 text-zinc-300">{Enum.at(@steps, 4)}</p>
          <a
            href="/images/wordpress-onboarding/connect-wordpress.png"
            class="mt-5 block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-300"
          >
            <img
              src="/images/wordpress-onboarding/connect-wordpress.png"
              width="1920"
              height="500"
              loading="lazy"
              alt="Frontman General settings with the Enable MCP and connect button"
              class="h-auto w-full rounded-lg"
            />
            <span class="mt-2 inline-block text-sm text-violet-200 underline underline-offset-4">
              Open the image to see it larger
            </span>
          </a>
        </div>
      </li>
    </ol>

    <section
      id="connection-status"
      class="mt-12 border-t border-white/10 pt-8"
    >
      <h2 class="font-headings text-xl font-semibold text-white">Check your connection</h2>
      <%= if @checked do %>
        <div
          id="check-result"
          role="status"
          tabindex="-1"
          autofocus
          class="mt-3 leading-7 text-zinc-300"
        >
          <%= if @sites == [] do %>
            <p id="no-connected-sites">
              No connected sites found. Complete the WordPress connection steps above using this Frontman account, then check again.
            </p>
          <% else %>
            <p>
              Connected sites found. Return to your AI assistant and ask it to check your sites.
            </p>
            <ul id="connected-sites" class="mt-2 list-inside list-disc">
              <li :for={site <- @sites}>{site.label}</li>
            </ul>
          <% end %>
        </div>
      <% else %>
        <p class="mt-3 leading-7 text-zinc-300">
          After completing the steps, check for sites connected to this account.
        </p>
      <% end %>
      <.form
        id="check-connection"
        for={@check_form}
        action={~p"/wordpress/connect"}
        method="get"
      >
        <input type="hidden" name={@check_form[:check].name} value={@check_form[:check].value} />
        <button
          type="submit"
          class={[Layouts.connection_button_class(), "mt-4"]}
        >
          Check for connected sites
        </button>
      </.form>
      <div class="mt-8 border-t border-white/10 pt-6">
        <h3 class="font-headings text-lg font-semibold text-white">
          Return to your AI assistant
        </h3>
        <p class="mt-2 leading-7 text-zinc-300">
          Open your conversation and send: <strong>Check my connected WordPress sites.</strong>
        </p>
        <p class="mt-4 text-sm text-zinc-400">If you use ChatGPT:</p>
        <a
          href="https://chatgpt.com/"
          target="_blank"
          rel="noopener noreferrer"
          aria-describedby="chatgpt-new-tab"
          class="mt-2 inline-flex items-center justify-center rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-white/40 hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-300"
        >
          Open ChatGPT
        </a>
        <p id="chatgpt-new-tab" class="mt-2 text-sm text-zinc-400">Opens in a new tab.</p>
      </div>
    </section>
  </Layouts.connection>
</Layouts.app>
