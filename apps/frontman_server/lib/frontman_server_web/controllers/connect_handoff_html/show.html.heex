<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section aria-labelledby="connect-heading" class="mx-auto max-w-lg space-y-8">
    <div class="space-y-3 text-center">
      <p class="text-sm font-medium text-primary">AI assistant setup · Step 2 of 3</p>
      <h1
        id="connect-heading"
        class="text-balance font-headings text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
      >
        Confirm your Frontman account
      </h1>
      <div id="connect-value" class="space-y-2">
        <p class="font-semibold">One site. Two ways to work.</p>
        <p class="text-sm leading-6 text-base-content/70">
          Use Frontman's visual editor for hands-on changes, and your AI assistant for conversational updates.
          <span>Continue to authorize assistant access to your connected sites.</span>
        </p>
      </div>
    </div>

    <div class="card card-border bg-base-200 text-base-content shadow-xl">
      <div class="card-body gap-6 sm:p-8">
        <div class="space-y-2">
          <p class="text-sm text-base-content/70">Your Frontman account</p>
          <p id="connect-account" class="break-words font-semibold">
            {@current_scope.user.email}
          </p>
          <.form
            for={@form}
            action={~p"/auth/mcp/workos/switch-account"}
            method="post"
            id="connect-switch-account"
          >
            <input type="hidden" name={@form[:ref].name} value={@form[:ref].value} />
            <button
              type="submit"
              class="link rounded-sm text-sm text-primary underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
            >
              Use a different account
            </button>
          </.form>
        </div>

        <div class="space-y-2 border-t border-base-content/10 pt-5">
          <h2 class="font-semibold">What happens next</h2>
          <p class="text-sm leading-6 text-base-content/70">
            Continue to authorize your assistant to use the WordPress sites connected to this account. Depending on the tools available, it can read, change, and delete site content.
          </p>
          <p class="text-sm leading-6 text-base-content/70">
            If your site is not connected yet, you will approve its access separately.
          </p>
        </div>

        <.form
          for={@form}
          action={~p"/auth/mcp/workos/pending"}
          method="post"
          id="connect-handoff"
          aria-describedby="connect-permissions"
          class="space-y-4"
        >
          <input type="hidden" name={@form[:ref].name} value={@form[:ref].value} />
          <button
            type="submit"
            id="connect-continue"
            class="btn btn-lg btn-block border-primary-700 bg-primary-700 text-white hover:border-primary-800 hover:bg-primary-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >
            Continue to your assistant <.icon name="hero-arrow-right" class="size-4" />
          </button>
        </.form>
        <p id="connect-permissions" class="text-center text-sm leading-6 text-base-content/60">
          This does not connect a new website, start a subscription, or change your site content.
        </p>
      </div>
    </div>

    <div class="text-center">
      <.link
        href={~p"/"}
        id="connect-back"
        class="link link-hover rounded-sm text-sm text-base-content/60 transition-colors hover:text-base-content focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        Back to Frontman
      </.link>
    </div>
  </section>
</Layouts.app>
