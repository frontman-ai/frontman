<Layouts.app flash={@flash} current_scope={@current_scope} focused>
  <Layouts.connection
    title={
      cond do
        !@selected -> "Connect your WordPress site"
        match?({:allowed, _}, @access_status) -> "Your site is ready"
        @conn.params["checkout"] == "success" -> "Confirming your plan"
        true -> "Get assistant access"
      end
    }
    step={if @selected, do: 3, else: 2}
  >
    <:intro>
      <p id="connect-value">
        {if @selected,
          do: "Update your site from the conversation you already have open.",
          else: "Connect Frontman to the site you want to work on."}
      </p>
    </:intro>
    <section
      id="hosted-setup"
      data-setup-page-url={
        if @ref, do: ~p"/auth/mcp/workos/pending?#{%{ref: @ref}}", else: ~p"/wordpress/connect"
      }
      data-setup-status-url={~p"/wordpress/connect/status?#{%{ref: @ref}}"}
      data-setup-revision={@revision}
      class="space-y-5"
    >
      <div :if={@sites == []} id="connect-no-sites" class="space-y-4">
        <.form for={@form} id="connect-site-launch" data-site-launch>
          <.input
            field={@form[:site_url]}
            type="url"
            label="WordPress site URL"
            placeholder="https://example.com"
            required
            class={Layouts.connection_input_class()}
          />
          <button
            name="setup_action"
            value="install"
            class={[Layouts.connection_button_class(), "mt-4"]}
          >Install Frontman</button>
          <button
            name="setup_action"
            value="open"
            class="mt-3 w-full text-center text-sm text-primary-200 underline"
          >Already installed? Open Frontman</button>
          <p data-site-launch-error role="alert" class="mt-2 text-sm text-warning" hidden>
            Enter an HTTPS site URL without a username, password, query, or fragment.
          </p>
        </.form>
        <details class="text-sm leading-6 text-zinc-400">
          <summary class="cursor-pointer text-primary-200">How to connect your site</summary>
          <ol class="mt-3 list-decimal space-y-2 pl-5">
            <li>
              Install and activate the
              <a
                href="https://wordpress.org/plugins/frontman-agentic-ai-editor/"
                target="_blank"
                rel="noopener noreferrer"
                class="underline"
              >Frontman plugin</a>
              in your WordPress dashboard.
            </li>
            <li>Open Frontman and sign in as {@current_scope.user.email}.</li>
            <li>Choose Connect AI assistant, enable MCP, and connect your site.</li>
          </ol>
          <p class="mt-2">
            The dashboard opens in a new tab. Sign in as an administrator if asked. Keep this tab open; your site will appear automatically.
          </p>
        </details>
      </div>
      <.form
        :if={length(@sites) > 1 && !@selected}
        for={@form}
        action={~p"/wordpress/connect/site"}
        method="post"
        id="connect-select-site"
        data-once-submit
      >
        <input type="hidden" name="ref" value={@ref} />
        <.input
          field={@form[:site_id]}
          type="select"
          label="Choose your WordPress site"
          options={Enum.map(@sites, &{&1.label, &1.id})}
          prompt="Choose a site"
          required
          class={Layouts.connection_input_class()}
        />
        <button class={[Layouts.connection_button_class(), "mt-4"]}>Use this site</button>
      </.form>
      <div :if={@selected} id="connect-selected-site" class="rounded-2xl bg-white/5 px-4 py-3">
        <p class="text-xs text-zinc-400">Connected site</p>
        <p class="mt-1 break-all text-sm font-medium">{@selected.label}</p>
      </div>
      <section
        :if={@selected && !match?({:allowed, _}, @access_status)}
        id="connect-access"
        class="space-y-4"
      >
        <%= cond do %>
          <% @conn.params["checkout"] == "success" -> %>
            <p id="checkout-pending" role="status" class="text-sm leading-6 text-zinc-300">
              Waiting for Stripe confirmation. Keep this tab open; access updates automatically. You do not need to purchase again.
            </p>
          <% @offers == {:ok, []} -> %>
            <p class="text-sm leading-6 text-zinc-300">
              Your existing plan needs attention. Update your subscription in Stripe to restore assistant access.
            </p>
          <% true -> %>
            <%= case @offers do %>
              <% {:ok, offers} -> %>
                <.form
                  for={@form}
                  action={~p"/wordpress/connect/checkout"}
                  method="post"
                  id="checkout-plan"
                  data-once-submit
                  class="space-y-4"
                >
                  <input type="hidden" name="ref" value={@ref} />
                  <fieldset class="space-y-2">
                    <legend class="mb-2 text-sm font-medium">Choose billing interval</legend>
                    <label
                      :for={offer <- offers}
                      class="flex cursor-pointer items-start gap-3 rounded-xl border border-white/10 p-3 text-sm has-[:checked]:border-primary-300"
                    >
                      <input
                        type="radio"
                        name="interval"
                        id={"checkout-#{offer.interval}"}
                        value={offer.interval}
                        checked={offer.interval == :monthly}
                        required
                        class="mt-1 accent-primary-300"
                      />
                      <span>
                        <span class="block font-medium">{if offer.interval == :monthly,
                          do: "Monthly",
                          else: "Yearly"} · {offer.label}</span>
                        <span
                          :if={offer.trial_days > 0}
                          class="mt-1 block text-xs leading-5 text-zinc-400"
                        >{offer.trial_days} days free, then {offer.label}. Cancel before the trial ends to avoid a charge.</span>
                        <span
                          :if={offer.trial_days == 0}
                          class="mt-1 block text-xs leading-5 text-zinc-400"
                        >Starts at checkout. Renews automatically unless canceled.</span>
                      </span>
                    </label>
                  </fieldset>
                  <p class="text-xs leading-5 text-zinc-400">
                    Payment method required. Renews automatically unless canceled. Taxes shown at checkout.
                  </p>
                  <button id="checkout-submit" class={Layouts.connection_button_class()}>Continue to checkout</button>
                </.form>
              <% {:error, _reason} -> %>
                <p id="checkout-unavailable" role="status" class="text-sm text-zinc-400">
                  Plan prices are temporarily unavailable. Refresh to try again.
                </p>
            <% end %>
        <% end %>
        <.form
          :if={@has_customer && @conn.params["checkout"] != "success"}
          for={@form}
          action={~p"/wordpress/connect/portal"}
          method="post"
          id="connect-billing-portal"
          data-once-submit
        >
          <input type="hidden" name="ref" value={@ref} />
          <button class={Layouts.connection_secondary_button_class()}>Manage existing plan in Stripe</button>
        </.form>
      </section>
      <.form
        :if={@selected && match?({:allowed, _}, @access_status) && @ref}
        for={@form}
        action={~p"/auth/mcp/workos/pending"}
        method="post"
        id="connect-handoff"
        data-once-submit
      >
        <input type="hidden" name="ref" value={@ref} />
        <input type="hidden" name="site_id" value={@selected.id} />
        <p id="connect-permissions" class="mb-3 text-sm leading-6 text-zinc-400">
          Your assistant can read, change, and delete content across connected sites in this account.
        </p>
        <details class="mb-5 text-xs leading-5 text-zinc-400">
          <summary class="cursor-pointer text-primary-200">Access details</summary>
          <p class="mt-2">
            This selection does not restrict access to only one site. Available tools determine what your assistant can do. No site changes run automatically.
          </p>
        </details>
        <button id="connect-continue" class={Layouts.connection_button_class()}>Continue to your assistant</button>
      </.form>
      <p
        :if={@selected && match?({:allowed, _}, @access_status) && !@ref}
        id="connect-finished"
        class="text-sm leading-6 text-zinc-300"
      >
        Return to your AI assistant and add Frontman. Your saved site is ready.
      </p>
      <details class="border-t border-white/10 pt-4 text-xs leading-5 text-zinc-400">
        <summary class="cursor-pointer">Account and setup details</summary>
        <p id="connect-account" class="mt-3 break-all">{@current_scope.user.email}</p>
        <.form
          :if={@ref}
          for={@form}
          action={~p"/auth/mcp/workos/switch-account"}
          method="post"
          id="connect-switch-account"
        >
          <input type="hidden" name="ref" value={@ref} />
          <button class="mt-2 text-primary-200 underline">Use a different account</button>
        </.form>
        <.form
          :if={length(@sites) > 1 && @selected}
          for={@form}
          action={~p"/wordpress/connect/site"}
          method="post"
          id="connect-change-site"
          class="mt-3"
          data-once-submit
        >
          <input type="hidden" name="ref" value={@ref} />
          <.input
            field={@form[:site_id]}
            type="select"
            label="Choose a different site"
            options={Enum.map(@sites, &{&1.label, &1.id})}
            required
            class={Layouts.connection_input_class()}
          />
          <button class="mt-2 text-primary-200 underline">Use this site</button>
        </.form>
        <p id="setup-observation" role="status" class="mt-3">
          This page checks for site and plan changes for up to 10 minutes.
        </p>
        <p :if={@ref} class="mt-2">
          This request expires after 15 minutes. Restart from your original AI assistant if needed. Your connected sites and plan are saved.
        </p>
        <a
          href={
            if @ref,
              do: ~p"/auth/mcp/workos/pending?#{%{ref: @ref}}",
              else: ~p"/wordpress/connect"
          }
          class="mt-2 inline-block text-primary-200 underline"
        >Refresh setup status</a>
      </details>
    </section>
  </Layouts.connection>
</Layouts.app>
