<Layouts.app flash={@flash} current_scope={@current_scope} focused>
  <Layouts.connection title="Sign in to Frontman" assistant={@assistant_connection}>
    <:intro>
      <%= if @embedded_request do %>
        Continue to connect <strong class="break-all">{@embedded_request["origin"]}</strong>
        to your account.
      <% else %>
        Sign in or create an account to connect your site.
      <% end %>
    </:intro>
    <div class="space-y-4">
      <.form
        :if={@embedded_request && @current_scope}
        for={%{}}
        action={~p"/users/log-in"}
        id="embedded-connect-form"
      >
        <.embedded_request request={@embedded_request} />
        <input type="hidden" name="user_id" value={@current_scope.user.id} />
        <button
          type="submit"
          name="_action"
          value="connect"
          class={Layouts.connection_button_class()}
        >Continue as {@current_scope.user.email}</button>
      </.form>
      <div :if={!@current_scope || !@embedded_request} class="space-y-3">
        <.form for={%{}} action={~p"/auth/google"} id="google-login-form">
          <.embedded_request request={@embedded_request} />
          <button class={Layouts.connection_button_class()}>Continue with Google</button>
        </.form>
        <.form for={%{}} action={~p"/auth/github"} id="github-login-form">
          <.embedded_request request={@embedded_request} />
          <button class={Layouts.connection_secondary_button_class()}>Continue with GitHub</button>
        </.form>
      </div>
      <details
        :if={@assistant_connection}
        id="assistant-requirements"
        class="text-sm leading-6 text-zinc-400"
      >
        <summary class="cursor-pointer text-primary-200">Before you connect</summary>
        <p class="mt-2">
          Use the same account in WordPress and your assistant. Assistant tools require an active Frontman plan or eligible trial; no separate AI-provider API key is needed. Signing in does not start a subscription.
        </p>
      </details>
      <p class="text-xs leading-5 text-zinc-400">
        By signing in, you agree to our
        <a href="https://frontman.sh/terms/" class="underline">Terms of Service</a>
        and <a href="https://frontman.sh/privacy/" class="underline">Privacy Policy</a>.
      </p>
    </div>
  </Layouts.connection>
</Layouts.app>
