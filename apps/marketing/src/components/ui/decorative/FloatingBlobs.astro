---

type BlobConfig = {
	color: string
	size: number
	startX?: number
	startY?: number
}

type Props = {
	blobs?: BlobConfig[]
	speed?: number
}

const defaultBlobs: BlobConfig[] = [
	{
		color: '#9D7CFF',
		size: 450,
		startX: -12,
		startY: 50
	},
	{
		color: '#60A5FA',
		size: 550,
		startX: 85,
		startY: -15
	},
	{
		color: '#FCD34D',
		size: 500,
		startX: 82,
		startY: 90
	}
]

const { blobs = defaultBlobs, speed = 15 } = Astro.props
---

<div class="floating-blobs-container">
	{blobs.map((blob, index) => (
		<div
			class="floating-blob"
			data-blob-index={index}
			data-start-x={blob.startX ?? 50}
			data-start-y={blob.startY ?? 50}
			data-size={blob.size}
			style={`
				background: ${blob.color};
				width: ${blob.size}px;
				height: ${blob.size}px;
			`}
			aria-hidden="true"
		/>
	))}
</div>

<script is:inline define:vars={{ speed }}>
	class FloatingBlobsAnimation {
		constructor(speed) {
			this.speed = speed
			this.blobs = []
			this.isAnimating = false
		}

		init() {
			const blobElements = document.querySelectorAll('.floating-blob')

			const blobData = []
			blobElements.forEach((blobElement, index) => {
				blobData.push({
					element: blobElement,
					index,
					startX: parseFloat(blobElement.dataset.startX) || 50,
					startY: parseFloat(blobElement.dataset.startY) || 50,
					size: parseFloat(blobElement.dataset.size) || 100,
				})
			})

			blobData.forEach((data) => {
				data.element.style.transform = `translate(calc(${data.startX}cqw - 50%), calc(${data.startY}cqh - 50%))`
				data.element.style.transition = `transform ${this.speed}s ease-in-out`

				this.blobs.push({
					element: data.element,
					index: data.index,
					currentX: data.startX,
					currentY: data.startY,
				})
			})

			this.animate()
		}

		getRandomPosition() {
			const visiblePercentage = 60
			const maxOffscreen = (100 - visiblePercentage)

			const minX = -maxOffscreen
			const maxX = 100 + maxOffscreen

			const minY = -maxOffscreen
			const maxY = 100 + maxOffscreen

			const x = minX + Math.random() * (maxX - minX)
			const y = minY + Math.random() * (maxY - minY)

			return { x, y }
		}

		moveBlob(blob) {
			const newPos = this.getRandomPosition()

			blob.element.style.transform = `translate(calc(${newPos.x}cqw - 50%), calc(${newPos.y}cqh - 50%))`

			blob.currentX = newPos.x
			blob.currentY = newPos.y
		}

		animate() {
			if (this.isAnimating) return
			this.isAnimating = true

			this.blobs.forEach(blob => {
				this.moveBlob(blob)
			})

			setTimeout(() => {
				this.isAnimating = false
				this.animate()
			}, this.speed * 1000)
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		const animation = new FloatingBlobsAnimation(speed)
		animation.init()
	})
</script>

<style>
	@reference "../../../styles/global.css";
	.floating-blobs-container {
		@apply absolute inset-0 overflow-hidden pointer-events-none;
		container-type: size;
		z-index: 1;
	}

	.floating-blob {
		@apply absolute rounded-full pointer-events-none;
		left: 0;
		top: 0;
		will-change: transform;
		z-index: 1;
	}
</style>
