---

type Props = {
	type?: 'link' | 'button' | 'submit' | 'reset'
	size?: 'lg' | 'base' | 'sm'
	link?: string
	target?: '_blank' | '_self'
	modal?: string
	style?: 'primary' | 'secondary' | 'neutral' | 'white'
	variation?: 'outline' | 'link'
	elevated?: boolean
	classes?: string
	'data-ga-event'?: string
	'data-ga-category'?: string
	'data-ga-label'?: string
	'data-ga-placement'?: string
	'data-ga-destination'?: string
	'data-ga-task-family'?: string
}
const {
	type = 'button',
	size = 'base',
	link,
	target,
	modal,
	style = 'primary',
	variation,
	elevated,
	classes,
	'data-ga-event': gaEvent,
	'data-ga-category': gaCategory,
	'data-ga-label': gaLabel,
	'data-ga-placement': gaPlacement,
	'data-ga-destination': gaDestination,
	'data-ga-task-family': gaTaskFamily
} = Astro.props
const dimensions = {
	'data-ga-placement': gaPlacement,
	'data-ga-destination': gaDestination,
	'data-ga-task-family': gaTaskFamily
}
---

{
	type === 'link' || link ? (
		<a
			href={link}
			target={target}
			rel={target === '_blank' ? 'noopener noreferrer' : undefined}
			class:list={[
				'button',
				{ ['button--' + `${size}`]: size },
				{ ['button--' + `${style}`]: style },
				{ ['button--' + `${variation}`]: variation },
				{ ['button--elevated']: elevated },
				{ [`${classes}`]: classes }
			]}
			{...(gaEvent ? { 'data-ga-event': gaEvent } : {})}
			{...(gaCategory ? { 'data-ga-category': gaCategory } : {})}
			{...(gaLabel ? { 'data-ga-label': gaLabel } : {})}
			{...dimensions}
		>
			<slot />
			{target === '_blank' && <span class="button__new-tab"> (opens in a new tab)</span>}
		</a>
	) : (
		<button
			type={type}
			class:list={[
				'button',
				{ ['button--' + `${size}`]: size },
				{ ['button--' + `${style}`]: style },
				{ ['button--' + `${variation}`]: variation },
				{ ['button--elevated']: elevated },
				{ [`${classes}`]: classes }
			]}
			{...(modal ? { 'data-modal': modal } : {})}
			{...(gaEvent ? { 'data-ga-event': gaEvent } : {})}
			{...(gaCategory ? { 'data-ga-category': gaCategory } : {})}
			{...(gaLabel ? { 'data-ga-label': gaLabel } : {})}
			{...dimensions}
		>
			<slot />
		</button>
	)
}
<style>
	@reference "../../styles/global.css";
	.button {
		@apply inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap lg:whitespace-nowrap font-bold tracking-wide transition duration-300 disabled:cursor-not-allowed disabled:shadow-none;
		font-family: var(--font-sans);
		border-radius: 8px;
	}
	.button__new-tab {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	@media (max-width: 480px) {
		.button {
			white-space: normal;
		}
	}

	.button--lg {
		@apply h-14 px-8 text-base [&.button--elevated]:shadow-lg [&.button--elevated]:hover:shadow-md [&.button--elevated]:focus:shadow-md;
	}

	.button--base {
		@apply h-10 px-5 text-sm [&.button--elevated]:shadow-md [&.button--elevated]:hover:shadow-sm [&.button--elevated]:focus:shadow-sm;
	}

	.button--sm {
		@apply h-8 px-4 text-xs [&.button--elevated]:shadow-md [&.button--elevated]:hover:shadow-sm [&.button--elevated]:focus:shadow-sm;
	}
	.button--outline {
		@apply border;
	}
	.button--link {
		@apply inline-flex items-center justify-start gap-2 px-0 font-normal;
	}
	.button--primary {
		@apply bg-primary-600 text-white hover:bg-primary-700 focus:bg-primary-700 disabled:border-primary-300 disabled:bg-primary-300 [&.button--elevated]:shadow-lg [&.button--elevated]:shadow-primary-600/30 [&.button--elevated]:hover:shadow-primary-600/30 [&.button--elevated]:focus:shadow-primary-600/30 [&.button--link]:bg-transparent [&.button--link]:text-primary-600 hover:[&.button--link]:text-primary-700 focus:[&.button--link]:text-primary-700 [&.button--outline]:border-primary-600 [&.button--outline]:bg-transparent [&.button--outline]:text-primary-600 [&.button--outline]:hover:border-primary-700 [&.button--outline]:hover:text-primary-700;
	}

	.button--secondary {
		@apply bg-primary-50 text-primary-500 hover:bg-primary-100 hover:text-primary-600 focus:bg-primary-200 focus:text-primary-700 disabled:border-primary-300 disabled:bg-primary-100 disabled:text-primary-400 [&.button--elevated]:shadow-primary-500/30 [&.button--elevated]:hover:shadow-primary-500/30 [&.button--elevated]:focus:shadow-primary-500/30 [&.button--link]:bg-transparent [&.button--link]:text-primary-500 hover:[&.button--link]:text-primary-600 focus:[&.button--link]:text-primary-600 [&.button--link_svg]:stroke-primary-500 [&.button--outline]:border-primary-500 [&.button--outline]:bg-transparent [&.button--outline]:text-primary-500 [&.button--outline]:hover:border-primary-600 [&.button--outline]:hover:text-primary-600 [&_svg]:stroke-primary-500;
	}

	.button--neutral {
		@apply bg-neutral-700 text-white hover:bg-neutral-800 focus:bg-neutral-900 disabled:border-neutral-300 disabled:bg-neutral-300 [&.button--elevated]:shadow-neutral-500/30 [&.button--elevated]:hover:shadow-neutral-500/30 [&.button--elevated]:focus:shadow-neutral-500/30 [&.button--link]:bg-transparent [&.button--link]:text-neutral-700 hover:[&.button--link]:text-neutral-800 focus:[&.button--link]:text-neutral-900 [&.button--outline]:border-neutral-700 [&.button--outline]:bg-transparent [&.button--outline]:text-neutral-700 [&.button--outline]:hover:border-neutral-800 [&.button--outline]:hover:text-neutral-800;
	}

	.button--white {
		@apply disabled:border-neutral-300 disabled:bg-neutral-300 [&.button--elevated]:shadow-neutral-500/30 [&.button--elevated]:hover:shadow-neutral-500/30 [&.button--elevated]:focus:shadow-neutral-500/30 [&.button--link]:bg-transparent [&.button--link]:text-white [&.button--outline]:border-white [&.button--outline]:bg-transparent [&.button--outline]:text-white;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 16px;
		line-height: 22px;
		letter-spacing: -0.01em;
		color: #1a1130;
		background: var(--color-neutral-50);
		border: none;
		border-radius: 12px;
		box-shadow: 0 2px 8px rgb(35 18 61 / 0.16);
		transition: background-color 200ms, color 200ms, box-shadow 200ms, transform 200ms;
	}

	.button--white:hover {
		color: #0f0a1a;
		background: var(--color-primary-50);
		box-shadow: 0 4px 12px rgb(35 18 61 / 0.2);
		transform: translateY(-1px);
	}

	.button--white:active {
		transform: translateY(0.5px);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.8),
			0 1px 2px rgba(0, 0, 0, 0.1);
		transition-duration: 0.06s;
	}

	.button--white:focus-visible {
		outline: 2px solid white;
		outline-offset: 3px;
	}
</style>
