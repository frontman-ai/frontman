---
// Install Steps Section
// ------------
// Description: A section displaying the 3-step installation process for FrontEnd
// Note: This section doesn't use the Section wrapper component to allow
// coast-to-coast decorative elements (floating blobs) while keeping content centered

// Components
// - Layout
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import StepCard from '../../ui/cards/StepCard.astro'
// - Decorative
import FloatingBlobs from '../../ui/decorative/FloatingBlobs.astro'
---

<section id="install" class="install-section">
	<!-- Floating decorative blobs (coast to coast) -->
	<FloatingBlobs
		blobs={[
			{ color: '#9D7CFF', size: 450, startX: -12, startY: 50 },
			{ color: '#60A5FA', size: 550, startX: 85, startY: -15 },
			{ color: '#FCD34D', size: 500, startX: 82, startY: 90 }
		]}
		speed={20}
	/>

	<!-- Content container (centered with padding) -->
	<div class="container">
		<Row>
			<Col span="12" align="center" classes="mb-16">
				<h2 class="install-title">
					How to install Frontman
				</h2>
				<p class="install-subtitle">
					Installing Frontman takes less than 5 minutes, and you'll have Frontman ready to start making changes to your project visually
				</p>
			</Col>
		</Row>
		<Row classes="install-cards-row gap-5">
			<Col span="4">
				<StepCard
					stepNumber="Step 1"
					title="Install locally"
					description="Run one command in your project folder"
					bgColor="#FFF4CC"
				>
					<div class="code-block">
						<code>curl https://frontman.sh/install/nextjs | bash</code>
						<button class="copy-button" aria-label="Copy to clipboard">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>
						</button>
					</div>
				</StepCard>
			</Col>
			<Col span="4">
				<StepCard
					stepNumber="Step 2"
					title="Open Frontman"
					description="Visit localhost/frontman in your browser."
					bgColor="#FFD6E8"
				>
					<p class="example-text">
						example:<br />
						http://localhost:3000/frontman
					</p>
				</StepCard>
			</Col>
			<Col span="4">
				<StepCard
					stepNumber="Step 3"
					title="Connect your AI"
					description="Connect to your preferred AI model subscription"
					bgColor="#FFE4D6"
				>
					<p class="support-note">
						(Frontman supports Claude, Chat GPT and Open Router)
					</p>
				</StepCard>
			</Col>
		</Row>
	</div>
</section>

<style>
	.install-section {
		@apply relative overflow-hidden py-32;
		background: #FAFAFA;
	}

	.container {
		@apply relative z-[100] mx-auto px-6;
	}

	.install-title {
		@apply font-headings text-5xl lg:text-6xl font-bold text-black relative;
		z-index: 100;
	}

	.install-subtitle {
		@apply mt-6 text-xl text-neutral-700 max-w-3xl mx-auto relative;
		z-index: 100;
	}

	.install-cards-row {
		@apply relative;
		z-index: 100;
	}

	.code-block {
		@apply mt-6 relative flex items-center gap-3 px-6 py-4 font-mono;
		background-color: #000000;
		border-radius: 16px;
		font-size: 14px;
		color: #C084FF;
	}

	.code-block code {
		@apply flex-1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.copy-button {
		@apply flex-shrink-0 p-2 transition-opacity hover:opacity-70 cursor-pointer;
		background: none;
		border: none;
		color: #C084FF;
	}

	.example-text {
		@apply mt-6 text-base text-neutral-800;
	}

	.support-note {
		@apply mt-6 text-sm text-neutral-700;
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const copyButton = document.querySelector('.copy-button')
		if (copyButton) {
			copyButton.addEventListener('click', async () => {
				const codeBlock = copyButton.closest('.code-block')
				const code = codeBlock?.querySelector('code')?.textContent
				if (code) {
					try {
						await navigator.clipboard.writeText(code)
						// Optional: Add visual feedback
						const originalHTML = copyButton.innerHTML
						copyButton.innerHTML = `
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						`
						setTimeout(() => {
							copyButton.innerHTML = originalHTML
						}, 2000)
					} catch (err) {
						console.error('Failed to copy:', err)
					}
				}
			})
		}
	})
</script>
