---
// Home page CTA Section
// ------------
// Description: A centered call to action section that contains: a title, text, a user review snippet, a button and a image.

// Components
// - UI
import OpenSourceBadge from '../../ui/OpenSourceBadge.astro'
import { Image } from 'astro:assets'
import Button from '../../ui/Button.astro'

// Content
// - Hero Image
import heroImage from '../../../assets/frontman-example.png'
// - Background Pattern
import gridNetBackground from '../../../assets/grid-net-background.svg'
// - Logo (from public folder)
const logoImage = { src: '/logo.svg' }
---

<section id="intro" class="hero-section bg-primary-500">
	<div class="hero-section__bg">
		<img src={gridNetBackground.src} alt="" class="hero-section__bg-image" />
	</div>
	<div class="hero-section__container">
		<div class="hero-section__content">
			<div class="hero-section__text">
				<img src={logoImage.src} alt="Frontman logo" class="hero-section__logo" />
				<OpenSourceBadge classes="mb-6" />
				<h1 class="hero-section__title">AI Frontend Editing Directly in Your Browser</h1>
				<p class="hero-section__subtitle">Frontman lets you skip the "refresh and check" cycle and brings non-coding teammates into the workflow</p>
				<div class="hero-section__cta">
					<Button size="lg" style="white" link="#install">Get Started For Free</Button>
					<a href="https://github.com/frontman-ai/frontman" target="_blank" rel="noopener noreferrer" class="hero-section__github-link">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" height="20" width="20" aria-hidden="true">
							<path fill="currentColor" fill-rule="evenodd" d="M24 1.5C11.574 1.5 1.5 11.574 1.5 24c0 9.934 6.441 18.362 15.382 21.34 1.125.207 1.536-.488 1.536-1.084 0-.534-.02-1.95-.03-3.828-6.258 1.36-7.578-3.016-7.578-3.016-1.023-2.598-2.497-3.29-2.497-3.29-2.04-1.395.155-1.367.155-1.367 2.256.158 3.443 2.316 3.443 2.316 2.004 3.434 5.26 2.442 6.54 1.867.204-1.452.784-2.443 1.426-3.004-4.997-.568-10.252-2.498-10.252-11.12 0-2.456.878-4.466 2.318-6.04-.232-.57-1.005-2.858.22-5.957 0 0 1.89-.605 6.192 2.307a21.598 21.598 0 0 1 5.646-.76c1.916.01 3.845.26 5.646.76 4.298-2.912 6.184-2.307 6.184-2.307 1.229 3.099.456 5.387.224 5.957 1.443 1.574 2.315 3.584 2.315 6.04 0 8.643-5.262 10.546-10.274 11.1.808.696 1.528 2.07 1.528 4.17 0 3.01-.028 5.44-.028 6.178 0 .6.406 1.3 1.548 1.08C40.066 42.356 46.5 33.93 46.5 24 46.5 11.574 36.426 1.5 24 1.5Z" clip-rule="evenodd"></path>
						</svg>
						Star on GitHub
					</a>
				</div>
			</div>
			<div class="hero-section__image-wrapper">
				<Image
					src={heroImage}
					alt="Frontman - AI Frontend Editing"
					class="hero-section__image"
					format="webp"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-section {
		position: relative;
		overflow: hidden;
		min-height: 600px;
	}
	@media (max-width: 1023px) {
		.hero-section {
			min-height: auto;
		}
	}
	.hero-section__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		opacity: 0.3;
	}
	.hero-section__bg-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
	.hero-section__container {
		position: relative;
		z-index: 1;
		padding: 40px 0 40px 24px;
		width: 100%;
	}
	@media (min-width: 1024px) {
		.hero-section__container {
			padding: 70px 0 90px 48px;
		}
	}
	.hero-section__content {
		display: flex;
		flex-direction: column;
		gap: 24px;
		align-items: flex-start;
		max-width: 1440px;
		margin: 0 auto;
		position: relative;
	}
	@media (min-width: 1024px) {
		.hero-section__content {
			flex-direction: row;
			align-items: center;
			gap: 48px;
		}
	}
	.hero-section__text {
		flex: 0 0 auto;
		width: 100%;
		max-width: 600px;
		padding-right: 24px;
	}
	@media (min-width: 1024px) {
		.hero-section__text {
			width: 45%;
			max-width: none;
			padding-right: 48px;
		}
	}
	.hero-section__logo {
		display: none;
	}
	@media (min-width: 1024px) {
		.hero-section__logo {
			display: block;
			width: 143px;
			height: 143px;
			margin-bottom: 32px;
		}
	}
	.hero-section__title {
		font-family: 'SF Pro Display', system-ui, helvetica, sans-serif;
		font-size: 36px;
		line-height: 42px;
		font-weight: 700;
		color: white;
		margin-bottom: 16px;
		max-width: 100%;
	}
	@media (min-width: 1024px) {
		.hero-section__title {
			font-size: 64px;
			line-height: 70px;
			margin-bottom: 24px;
			max-width: 700px;
		}
	}
	.hero-section__subtitle {
		font-size: 16px;
		line-height: 22px;
		color: white;
		margin-bottom: 24px;
		max-width: 100%;
	}
	@media (min-width: 1024px) {
		.hero-section__subtitle {
			font-size: 18px;
			line-height: 25px;
			margin-bottom: 32px;
			max-width: 700px;
		}
	}
	.hero-section__cta {
		display: flex;
		flex-direction: column;
		gap: 12px;
		max-width: 100%;
		width: 100%;
	}
	.hero-section__cta .button {
		width: 100%;
	}
	@media (min-width: 1024px) {
		.hero-section__cta {
			flex-direction: row;
			align-items: center;
			gap: 16px;
			max-width: none;
		}
		.hero-section__cta .button {
			width: auto;
		}
	}
	.hero-section__github-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: white;
		font-family: 'SF Pro Display', system-ui, helvetica, sans-serif;
		font-weight: 480;
		font-size: 16px;
		line-height: 22px;
		text-decoration: none;
		transition: opacity 0.2s;
		white-space: nowrap;
	}
	.hero-section__github-link:hover {
		opacity: 0.8;
	}
	.hero-section__image-wrapper {
		flex: 1 1 auto;
		width: 100%;
		overflow: visible;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-right: 0;
		padding-right: 24px;
		padding-left: 0;
	}
	@media (min-width: 1024px) {
		.hero-section__image-wrapper {
			width: 55%;
			max-width: none;
			justify-content: flex-end;
			padding: 0;
			margin-right: -30px;
		}
	}
	.hero-section__image {
		width: 964px;
		height: auto;
		object-fit: cover;
		object-position: left center;
		display: block;
	}
	@media (max-width: 1023px) {
		.hero-section__image {
			width: 100%;
			max-width: 964px;
		}
	}
</style>
