<script is:inline>
	function initNavigation() {
		const nav = document.querySelector('.header__nav')
		if (!nav || nav.dataset.navigationInitialized) return
		window.frontmanNavigationCleanup?.()
		nav.dataset.navigationInitialized = 'true'

		const controller = new AbortController()
		const options = { signal: controller.signal }
		const headerToggle = nav.querySelector('.header__toggle')
		const headerMenu = nav.querySelector('.header__menu')
		const disclosures = nav.querySelectorAll('.header__menu-link[aria-controls]')
		const desktop = window.matchMedia('(min-width: 1024px)')

		function closeSubmenus() {
			disclosures.forEach((button) => button.setAttribute('aria-expanded', 'false'))
		}

		function closeMobileMenu() {
			closeSubmenus()
			headerToggle.classList.remove('header__toggle--open')
			headerToggle.setAttribute('aria-expanded', 'false')
			headerMenu.classList.remove('header__menu--open')
		}

		disclosures.forEach((button) => {
			button.addEventListener('click', () => {
				const wasOpen = button.getAttribute('aria-expanded') === 'true'
				closeSubmenus()
				button.setAttribute('aria-expanded', String(!wasOpen))
			}, options)
		})

		headerToggle.addEventListener('click', () => {
			const opening = headerToggle.getAttribute('aria-expanded') !== 'true'
			closeMobileMenu()
			headerToggle.setAttribute('aria-expanded', String(opening))
			headerToggle.classList.toggle('header__toggle--open', opening)
			headerMenu.classList.toggle('header__menu--open', opening)
		}, options)

		headerMenu.addEventListener('click', (event) => {
			if (event.target.closest('a')) closeMobileMenu()
		}, options)
		document.addEventListener('click', (event) => {
			if (!nav.contains(event.target)) closeMobileMenu()
			else if (!event.target.closest('.header__menu-item')) closeSubmenus()
		}, options)
		nav.addEventListener('focusout', (event) => {
			if (!nav.contains(event.relatedTarget)) closeMobileMenu()
		}, options)
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return
			const open = nav.querySelector('.header__menu-link[aria-expanded="true"]')
			if (open) {
				closeSubmenus()
				open.focus()
				event.preventDefault()
			} else if (headerToggle.getAttribute('aria-expanded') === 'true') {
				closeMobileMenu()
				headerToggle.focus()
				event.preventDefault()
			}
		}, options)
		desktop.addEventListener('change', closeMobileMenu, options)
		window.frontmanNavigationCleanup = () => {
			closeMobileMenu()
			controller.abort()
			delete nav.dataset.navigationInitialized
		}

		function openModal(modal) {
			if (modal && modal.classList.contains('modal')) {
				modal.classList.add('open')
			}
		}
		function closeModal(modal) {
			if (modal && modal.classList.contains('modal')) {
				modal.classList.remove('open')
			}
		}
		const modalButtons = document.querySelectorAll('[data-modal]')

		modalButtons.forEach(function (button) {
			button.addEventListener('click', function () {
				const modalId = button.getAttribute('data-modal')
				const modal = document.getElementById(modalId)
				openModal(modal)
			})
		})
		document.querySelectorAll('.modal').forEach(function (modal) {
			modal.addEventListener('click', function (event) {
				if (event.target === modal) {
					closeModal(modal)
				}
			})
			const close = modal.querySelector('.modal__close')
			if (close) {
				close.addEventListener('click', function (event) {
					event.stopPropagation()
					closeModal(modal)
				})
			}
		})
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initNavigation)
	} else {
		initNavigation()
	}

	document.addEventListener('astro:page-load', initNavigation)

	document.addEventListener('astro:before-swap', () => {
		window.frontmanNavigationCleanup?.()
	})
</script>

<script is:inline>
	(function () {
		function getGitHubClickPlacement(link) {
			if (link.closest('.hero-section, .hero')) return 'hero'
			if (link.closest('.header, nav')) return 'navbar'
			if (link.closest('.social-proof')) return 'social_proof'
			if (link.closest('.footer, footer')) return 'footer'
			if (link.closest('.integration-cta')) return 'integration_cta'
			if (link.classList.contains('open-source-badge') || link.closest('.open-source-badge'))
				return 'open_source_badge'
			if (link.classList.contains('button') || link.classList.contains('button--primary'))
				return 'cta_button'
			return 'other'
		}

		document.addEventListener('click', function (event) {
			var link = event.target.closest('a[href*="github.com/frontman-ai/frontman"]')
			if (!link) return

			var placement = getGitHubClickPlacement(link)

			if (typeof window.trackEvent !== 'function') return

			window.trackEvent('github_click', {
				link_url: link.href,
				link_text: (link.textContent || '').trim().substring(0, 100),
				link_placement: placement,
				page_path: window.location.pathname,
			})
		})
	})()
</script>

<script>
	document.documentElement.classList.add('dark')
</script>
