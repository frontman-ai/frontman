---
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import { Image } from 'astro:assets'
import UseCaseFaqSection from '../components/use-cases/UseCaseFaqSection.astro'
import gridNetBackground from '../assets/grid-net-background.svg'
import videoPlaceholder from '../assets/video-placeholder.png'

const SEO = {
	title: 'AI Website Editor for Marketing and Design Teams | Frontman',
	description:
		'Frontman helps marketing and design teams update existing Next.js, Astro, and Vite websites by clicking the live page and turning requests into reviewable code changes.'
}

const faqs = [
	{
		question: 'Can marketers and designers use Frontman without opening an IDE?',
		answer:
			'Yes. A developer installs Frontman once. After that, marketers and designers can work from the browser: click the live site, describe the update, review the result, and hand engineering a normal source-code diff.'
	},
	{
		question: 'Does Frontman bypass engineering review?',
		answer:
			'No. For Next.js, Astro, and Vite sites, Frontman runs in development and produces regular source changes. Your team can review, approve, and ship those changes through the same git and deployment workflow you already use.'
	},
	{
		question: 'What kinds of website changes fit this workflow?',
		answer:
			'Frontman is strongest for copy, CTAs, hero sections, spacing, colors, responsive polish, landing-page cleanup, visual QA, and small content or layout changes on existing websites.'
	},
	{
		question: 'Which stacks are supported?',
		answer:
			'Frontman supports Next.js, Astro, and Vite projects, including React, Vue, Svelte, SvelteKit, SolidJS, and vanilla Vite apps.'
	}
]

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer
		}
	}))
}

const useCases = [
	{ title: 'Campaigns that stay current.', description: 'Update landing-page copy, sharpen CTAs, and refresh pricing, feature, and comparison pages.', label: 'Marketing', color: 'bg-bg-cream' },
	{ title: 'Design feedback, made concrete.', description: 'Turn review comments into changes to spacing, alignment, colors, and responsive layouts.', label: 'Design', color: 'bg-bg-lavender' },
	{ title: 'Less ticket debt. More polish.', description: 'Fix visual QA issues before launch and give developers a concrete diff instead of another screenshot.', label: 'Website teams', color: 'bg-bg-lightblue' }
]

const workflowSteps = [
	{ title: 'Open your site', description: 'A developer installs Frontman once. Open your development site in the browser.' },
	{ title: 'Click what needs work', description: 'Select a headline, CTA, section, or layout issue directly on the rendered page.' },
	{ title: 'Describe the update', description: 'Ask in plain English. Frontman uses live page context and source mappings to edit the right files.' },
	{ title: 'Review the diff', description: 'Check the result together. Developers review, test, and ship through your existing workflow.' }
]
---

<Layout title={SEO.title} description={SEO.description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

	<section class="teams-hero relative overflow-hidden bg-primary-500 px-6 pb-10 pt-16 text-center md:pt-24">
		<img src={gridNetBackground.src} alt="" aria-hidden="true" width="1440" height="900" class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-30" />
		<div class="relative mx-auto max-w-[960px]">
			<div class="mx-auto max-w-[780px]">
				<p class="mb-5 inline-block rounded-lg bg-primary-950/60 px-4 py-2 font-mono text-xs uppercase tracking-[0.12em] text-white">For marketing and design teams</p>
				<h1 class="teams-hero__title">Your website. Your ideas.<br />No IDE required.</h1>
				<p class="mx-auto mb-7 mt-5 max-w-[620px] text-base leading-relaxed text-white md:text-lg">Click your Next.js, Astro, or Vite site. Describe the change. Get reviewable source changes your developers can approve—without turning every update into a ticket.</p>
				<div class="flex flex-col items-center gap-5">
					<Button size="lg" style="white" link="/#install">Add Frontman to your site <span aria-hidden="true">→</span></Button>
					<a href="/use-cases/designers/" class="rounded-xl border border-white/30 bg-primary-950/50 px-5 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-primary-950/70">Explore the designer workflow <span aria-hidden="true">→</span></a>
				</div>
			</div>
			<div style="aspect-ratio: 960 / 594" class="teams-demo-wrapper relative mt-10 overflow-hidden rounded-xl border border-white/25 bg-neutral-950 shadow-2xl">
			<button type="button" class="teams-demo relative block w-full cursor-pointer border-0 bg-transparent p-0" aria-label="Watch Frontman in action">
				<Image src={videoPlaceholder} alt="Frontman editing a website directly from the browser" width={960} widths={[400, 640, 960]} sizes="(max-width: 1008px) calc(100vw - 48px), 960px" format="webp" quality={80} loading="eager" fetchpriority="high" class="block h-auto w-full" />
				<span class="absolute inset-0 flex items-center justify-center">
					<span class="flex items-center gap-3 rounded-full border border-white/30 bg-neutral-950 px-6 py-4 text-sm font-semibold text-white shadow-xl"><span aria-hidden="true">▶</span> Watch Frontman in action</span>
				</span>
			</button>
			</div>
			<ul class="mt-7 flex list-none flex-wrap justify-center gap-x-7 gap-y-3 p-0 text-sm font-medium text-white">
				<li>Works on your existing site</li>
				<li>One developer install</li>
				<li>Normal code review</li>
			</ul>
		</div>
	</section>

	<section class="bg-neutral-950 px-6 py-16 text-neutral-300 md:py-24">
		<div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-2 md:gap-16">
			<div>
				<p class="teams-eyebrow text-primary-300">Less back-and-forth</p>
				<h2 class="teams-heading text-white">Start with the page.<br />Not another ticket.</h2>
				<p class="mt-6 leading-7">You know the headline is wrong. You can see the spacing is off. Small website edits shouldn't get lost between screenshots, backlog grooming, and developer interpretation.</p>
				<p class="mt-4 leading-7">Point at the real page, explain the outcome, and give your team a concrete change to review.</p>
			</div>
			<div class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 md:p-8">
				<p class="font-mono text-xs uppercase tracking-widest text-neutral-400">The usual handoff</p>
				<p class="mt-4 text-xl leading-relaxed text-neutral-400">Screenshot → Ticket → Clarification → Waiting</p>
				<div class="my-7 h-px bg-white/10"></div>
				<p class="font-mono text-xs uppercase tracking-widest text-primary-300">With Frontman</p>
				<p class="mt-4 text-2xl font-semibold leading-relaxed text-white">Point. Describe.<br /><span class="text-primary-300">Review the change.</span></p>
				<p class="mt-5 text-sm leading-6">The live DOM, CSS, routes, logs, and source mappings give the agent context—not just a screenshot.</p>
			</div>
		</div>
	</section>

	<section class="bg-white px-6 py-16 text-neutral-950 md:py-24">
		<div class="mx-auto max-w-5xl">
			<div class="mx-auto max-w-2xl text-center">
				<p class="teams-eyebrow text-primary-700">The team workflow</p>
				<h2 class="teams-heading">See it. Change it. Review it.</h2>
				<p class="mt-5 leading-7 text-neutral-600">Your team works from the page. Engineering keeps control of what ships.</p>
			</div>
			<ol class="mt-12 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
				{workflowSteps.map((step, index) => (
					<li class="rounded-2xl border-2 border-neutral-950 bg-neutral-50 p-6 shadow-[4px_4px_0_#020617]">
						<span class="mb-6 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-200 font-mono text-sm font-bold text-neutral-950">0{index + 1}</span>
						<h3 class="text-xl font-bold leading-tight">{step.title}</h3>
						<p class="mt-4 text-sm leading-6 text-neutral-600">{step.description}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="bg-neutral-950 px-6 py-16 md:py-24">
		<div class="mx-auto max-w-5xl">
			<p class="teams-eyebrow text-primary-300">Built for the everyday edits</p>
			<h2 class="teams-heading max-w-2xl text-white">Small changes.<br />A faster path to launch.</h2>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				{useCases.map((useCase) => (
					<article class:list={['rounded-2xl border-2 border-neutral-950 p-7 text-neutral-950', useCase.color]}>
						<p class="font-mono text-xs uppercase tracking-widest">{useCase.label}</p>
						<h3 class="mb-4 mt-8 text-2xl font-bold leading-tight">{useCase.title}</h3>
						<p class="text-base leading-7 text-neutral-700">{useCase.description}</p>
					</article>
				))}
			</div>
			<div class="mt-16 grid gap-8 border-t border-white/10 pt-12 md:grid-cols-2 md:gap-16">
				<h2 class="teams-heading text-white">Shorter handoff.<br />Same developer control.</h2>
				<div class="text-neutral-300">
					<p class="leading-7">Frontman does not turn marketers into production deployers. Framework integrations run in development, and production builds strip Frontman out.</p>
					<p class="mt-4 leading-7">Every edit lands as normal source changes. Review the diff, test the result, and ship through the same git and deployment workflow you already trust.</p>
				</div>
			</div>
		</div>
	</section>

	<UseCaseFaqSection faqs={faqs} />

	<section class="bg-neutral-950 px-6 py-16 md:py-24">
		<div class="mx-auto max-w-[640px]">
			<img src="/logo.svg" alt="Frontman" width="154" height="154" loading="lazy" class="mb-8" />
			<h2 class="teams-heading text-white">Your next update starts here.</h2>
			<p class="mb-8 mt-6 text-lg leading-8 text-neutral-300">Give your website team a faster edit loop. Install Frontman in your Next.js, Astro, or Vite site and let visual requests start from the page, not a ticket.</p>
			<Button size="lg" style="primary" link="/#install">Add Frontman <span aria-hidden="true">→</span></Button>
			<a href="/docs/installation/" class="mt-5 block w-fit text-sm text-neutral-300 underline underline-offset-4 hover:text-white">Read install docs</a>
		</div>
	</section>
</Layout>

<script>
	const trigger = document.querySelector<HTMLButtonElement>('.teams-demo')
	if (!trigger) throw new Error('Marketing teams demo button not found')

	trigger.addEventListener('click', () => {
		const wrapper = trigger.parentElement
		if (!wrapper) throw new Error('Marketing teams demo wrapper not found')

		const iframe = document.createElement('iframe')
		iframe.src = 'https://www.youtube-nocookie.com/embed/-4GD1GYwH8Y?autoplay=1&rel=0'
		iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0'
		iframe.title = 'Frontman demo video'
		iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
		iframe.allowFullscreen = true
		iframe.referrerPolicy = 'strict-origin-when-cross-origin'
		trigger.hidden = true
		wrapper.appendChild(iframe)
		iframe.focus()
	}, { once: true })
</script>

<style>
	.teams-demo-wrapper {
		aspect-ratio: 960 / 594;
	}
	.teams-demo[hidden] {
		display: none;
	}
	.teams-demo-wrapper :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.teams-hero {
		padding-top: 132px;
	}
	section.bg-white h2,
	section.bg-white h3,
	article h3 {
		color: #020617;
	}
	.teams-hero a[href="/use-cases/designers/"] {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	a[href="/docs/installation/"] {
		white-space: nowrap;
	}
	.teams-hero__title {
		font-family: 'SF Pro Display', system-ui, helvetica, sans-serif;
		font-size: clamp(34px, 5.2vw, 56px);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: white;
	}
	.teams-heading {
		font-size: clamp(30px, 3.5vw, 44px);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}
	.teams-eyebrow {
		margin-bottom: 16px;
		font-family: monospace;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.teams-demo:hover > span > span {
		background: #3C1F66;
	}
</style>
