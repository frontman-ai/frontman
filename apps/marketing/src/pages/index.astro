---
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import gridNetBackground from '../assets/grid-net-background.svg'

const pluginUrl = 'https://wordpress.org/plugins/frontman-agentic-ai-editor/'
const setupGuideUrl = '/docs/integrations/wordpress/'

const demoPreview = `
	<style>
		* { box-sizing: border-box; }
		html, body { margin: 0; height: 100%; background: #180d2b; }
		a { display: grid; place-items: center; height: 100%; position: relative; color: white; }
		img { position: absolute; width: 100%; height: 100%; object-fit: cover; }
		span { position: relative; display: grid; place-items: center; width: 80px; height: 80px; border-radius: 50%; background: #fff; color: #291344; box-shadow: 0 0 0 10px rgb(255 255 255 / .18); transition: transform 350ms cubic-bezier(.32,.72,0,1); }
		a:hover span { transform: scale(1.08); }
		a:focus-visible { outline: 4px solid white; outline-offset: -8px; }
		a:active span { transform: scale(.98); }
		@media (prefers-reduced-motion: reduce) { span { transition: none; } }
	</style>
	<a href="https://www.youtube-nocookie.com/embed/-4GD1GYwH8Y?autoplay=1&rel=0" aria-label="Play Frontman editing demo">
		<img src="/images/home-demo-poster.webp" alt="Frontman conversation alongside the live storefront preview">
		<span><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m9 5 11 7-11 7z"/></svg></span>
	</a>
`

const SEO = {
	title: 'Frontman — AI WordPress Editor for Existing Sites',
	description:
		'Edit your existing WordPress site with Frontman AI. Update Gutenberg blocks, Elementor pages, and navigation with WordPress-native tools beside live preview.'
}

const capabilities = [
	'Create, edit, and delete posts and pages',
	'Insert, update, move, and delete Gutenberg blocks',
	'Edit Elementor pages with Elementor-aware tools',
	'Add and update navigation menu items',
	'Read and change allowlisted settings like title, tagline, and permalinks',
	'Browse and update block templates and template parts',
	'Manage widgets and flush WordPress cache',
	'Work with WooCommerce data when WooCommerce is active'
]

const faqs = [
	{
		question: 'What is Frontman for WordPress?',
		answer:
			'Frontman for WordPress is an AI editor plugin for existing WordPress sites. It adds a Frontman workspace with chat, WordPress-native tools, and live site preview so administrators can describe changes and review the result in context.'
	},
	{
		question: 'How do I install it?',
		answer:
			'Install Frontman - AI Website Editor from the WordPress Plugin Directory in wp-admin: Plugins > Add New Plugin, search for Frontman - AI Website Editor, install, activate, then open Frontman from the WordPress admin menu. Sign in to Frontman, arrange service access, and connect your own supported AI provider.'
	},
	{
		question: 'Does it work with Elementor?',
		answer:
			'Yes. Frontman includes Elementor-aware tools for inspecting and editing Elementor-backed pages, while keeping the page preview visible during the workflow.'
	},
	{
		question: 'Can I use it on production?',
		answer:
			'Yes. Frontman for WordPress is production-ready. Writes affect the connected installation, so published content on a live site can change immediately. Use staging for higher-risk work, keep backups, and inspect the resulting page. Recovery depends on the type of change.'
	},
	{
		question: 'Who can access Frontman in WordPress?',
		answer:
			'Only WordPress users with the manage_options capability can access Frontman. Tool requests are protected with WordPress nonces, and site option writes are restricted to allowlisted settings.'
	}
]

const pageJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'SoftwareSourceCode',
			name: 'Frontman for WordPress',
			description: SEO.description,
			url: 'https://frontman.sh/',
			codeRepository: 'https://github.com/frontman-ai/frontman',
			license: 'https://spdx.org/licenses/GPL-2.0-or-later.html',
			runtimePlatform: 'WordPress',
			sameAs: [pluginUrl, 'https://github.com/frontman-ai/frontman']
		},
		{
			'@type': 'FAQPage',
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: faq.answer
				}
			}))
		}
	]
}
---

<Layout
	title={SEO.title}
	description={SEO.description}
	ogImage="/blog/frontman-wordpress-plugin-released-cover.png"
	ogImageWidth={1200}
	ogImageHeight={450}
	ogImageAlt="Frontman WordPress Plugin Released"
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
	<script>
		import { registerHomepageTools } from '../integrations/webmcp.mjs'
		void registerHomepageTools(document).catch((error) => {
			console.error('[WebMCP] Page tool registration failed.', error)
		})
	</script>

	<section class="wp-hero">
		<div class="wp-hero__bg">
			<img src={gridNetBackground.src} alt="Decorative grid background" aria-hidden="true" class="wp-hero__bg-image" width="1440" height="900" fetchpriority="high" />
		</div>
		<div class="wp-container wp-hero__grid">
			<div class="wp-hero__content">
				<h1>
					<span>The best AI agent</span>{' '}
					<span>for WordPress.</span>
				</h1>
				<p class="wp-lead">
					Describe what you want. Frontman edits your pages, content, and navigation with WordPress-native tools for Gutenberg and Elementor. See the results in your live site preview.
				</p>
				<div class="wp-actions wp-hero__cta">
					<Button size="lg" style="white" link={pluginUrl} data-ga-event="click_wordpress_plugin" data-ga-category="engagement" data-ga-label="wordpress_home_hero" data-ga-placement="hero" data-ga-destination="wordpress_org">Install plugin <span aria-hidden="true">→</span></Button>
				</div>
			</div>
			<figure id="demo" class="wp-demo">
					<div class="wp-video-wrapper">
						<iframe
							src="https://www.youtube-nocookie.com/embed/-4GD1GYwH8Y"
							srcdoc={demoPreview}
							title="Frontman WordPress editing demo"
							width="960"
							height="540"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen
						></iframe>
					</div>
					<figcaption>From idea to updated page. Watch Frontman edit WordPress beside your live preview.</figcaption>
			</figure>
		</div>
	</section>

	<section class="wp-section wp-workflow" aria-labelledby="workflow-title">
		<div class="wp-container">
			<h2 id="workflow-title">Describe. Inspect. Refine.</h2>
			<ol class="wp-steps" role="list">
				<li><h3>Describe one update</h3><p>Ask for a bounded change. Select an element when it helps clarify the request.</p></li>
				<li><h3>Inspect the page</h3><p>See your updated content and layout right in the live preview.</p></li>
				<li><h3>Refine the result</h3><p>Ask for a focused adjustment, then check the screen sizes your visitors use.</p></li>
			</ol>
			<p class="wp-note">Your next site update starts with a conversation. <a href={setupGuideUrl} class="wp-copy-link">Get started with Frontman →</a></p>
		</div>
	</section>

	<section class="wp-section wp-section--raised" aria-labelledby="customer-story-title">
		<div class="wp-container">
			<div class="wp-section-header">
				<h2 id="customer-story-title">Real sites. Real transformations.</h2>
			</div>
			<div class="wp-split">
				<div>
					<h3 class="wp-story-heading">An Elementor redesign, led by marketing.</h3>
					<p>With no prior WordPress experience, Guy Leshno redesigned AutonomyAI’s existing Elementor site using Frontman.</p>
					<a href="/blog/autonomyai-wordpress-redesign-case-study/" class="wp-story-link" data-ga-event="click_customer_story" data-ga-category="engagement" data-ga-label="wordpress_home_customer_story">Read the customer story →</a>
				</div>
				<figure class="wp-quote">
					<blockquote>“Without Frontman, I would never have been able to accomplish this task by myself.”</blockquote>
					<figcaption>Guy Leshno <span>Marketing Lead, AutonomyAI</span></figcaption>
				</figure>
			</div>
			<div class="wp-comparison">
				<figure>
					<figcaption>Before</figcaption>
					<img src="/blog/autonomyai-homepage-before.webp" alt="AutonomyAI’s previous dark homepage, headed The OS for Building in Production" width="1600" height="1446" loading="lazy" decoding="async" />
				</figure>
				<figure>
					<figcaption>After</figcaption>
					<img src="/blog/autonomyai-homepage-after.webp" alt="AutonomyAI’s redesigned light homepage, headed Better Delivery, Built with Autonomy" width="1600" height="1506" loading="lazy" decoding="async" />
				</figure>
			</div>
			<p class="wp-disclosure">Customer-reported result in a Frontman-authored case study, not a controlled benchmark or guaranteed outcome. The original before capture date is unavailable; the after capture was checked August 27, 2026.</p>
		</div>
	</section>

	<section id="wordpress-features" class="wp-section">
		<div class="wp-container">
			<div class="wp-section-header">
				<h2>Start with one job on your existing site.</h2>
			</div>
			<ul class="wp-capabilities" role="list">
				<li class="wp-capability"><h3>Headline and CTA copy</h3><p>Replace a stale message or clarify the next action.</p></li>
				<li class="wp-capability"><h3>A Gutenberg or Elementor section</h3><p>Update content or adjust a section without rebuilding the site.</p></li>
				<li class="wp-capability"><h3>Navigation</h3><p>Add or update a menu item, then check its destination.</p></li>
			</ul>
			<details class="wp-more-capabilities">
				<summary>More WordPress capabilities</summary>
				<ul>{capabilities.map((capability) => <li>{capability}</li>)}</ul>
			</details>
			<p class="wp-note">Prefer working in ChatGPT? <a href="/chatgpt/" class="wp-copy-link">Connect Frontman to edit your WordPress site from ChatGPT.</a></p>
		</div>
	</section>

	<section id="wordpress-plugins" class="wp-section wp-section--raised" aria-labelledby="plugins-title">
		<div class="wp-container">
			<div class="wp-section-header">
				<h2 id="plugins-title">Built around the plugins you already use.</h2>
				<p>Keep your page builder. Keep your store. Keep the WordPress setup you’ve made your own.</p>
			</div>
			<p>Refresh your Elementor landing page for a campaign, rewrite WooCommerce product descriptions, or fine-tune a Yoast SEO Free title. Tell Frontman what needs changing, not which plugin screen to open.</p>
			<p>Also works with Polylang, Redirection, WP Rocket, W3 Total Cache, and LiteSpeed Cache.</p>
		</div>
	</section>

	<section id="wordpress-safety" class="wp-section">
		<div class="wp-container wp-split">
			<div>
				<p class="wp-label">Safety</p>
				<h2>Know what changes immediately.</h2>
			</div>
			<div class="wp-copy">
				<p>Frontman for WordPress is production-ready. Writes persist to the connected WordPress installation. Published content on a live site can change immediately; preview is not a universal approval gate. Draft publication and staging promotion still use your normal process.</p>
				<p>Only administrators can access it. Tool requests use WordPress nonces. Site option writes are restricted to allowlisted settings. Keep backups and use staging for higher-risk work. Recovery is selective: Elementor snapshots and applicable WordPress revisions help with some changes, but there is no universal undo.</p>
				<p>Use our <a href="/blog/wordpress-maintenance-checklist/" class="wp-copy-link">risk-based WordPress maintenance checklist</a> to turn staging, backup, verification, and recovery advice into a recurring operating process.</p>
			</div>
		</div>
	</section>

	<section class="wp-section wp-section--raised">
		<div class="wp-container">
			<h2>Common questions</h2>
			<div class="wp-faqs">
				{faqs.map((faq) => (
					<details class="wp-faq">
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section id="install" class="wp-final">
		<div class="wp-container wp-narrow wp-install">
			<h2>Install Frontman for WordPress.</h2>
			<p class="wp-install__steps">In wp-admin, open Plugins → Add New Plugin, install and activate Frontman. Sign in with GitHub or Google, then connect your AI provider.</p>
			<div class="wp-actions wp-actions--center">
				<Button size="lg" style="white" link={pluginUrl} data-ga-event="click_wordpress_plugin" data-ga-category="engagement" data-ga-label="wordpress_home_final" data-ga-placement="article_end" data-ga-destination="wordpress_org">Install plugin</Button>
			</div>
			<div class="wp-install__details">
				<p>WordPress 6.0+ and PHP 7.4+. Administrator access, Frontman sign-in and service access required. AI-provider costs are separate.</p>
				<div class="wp-install__links">
					<a class="wp-setup-link" href={setupGuideUrl}>WordPress setup guide</a>
					<a class="wp-setup-link" href="/pricing/">Pricing</a>
					<a class="wp-setup-link" href="/docs/api-keys/">Provider connection guide</a>
					<a class="wp-setup-link" href="/frameworks/#install" data-ga-event="click_framework_setup" data-ga-category="engagement" data-ga-label="wordpress_home_setup" data-ga-placement="setup" data-ga-destination="framework_guide">Framework setup →</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	@reference "../styles/global.css";

	.wp-container { @apply mx-auto max-w-marketing px-page-gutter; }
	.wp-narrow { max-width: 48rem; }
	.wp-label { @apply mb-3 text-sm font-medium tracking-wide; color: var(--wp-accent); }
	.wp-hero, .wp-section, .wp-final {
		--wp-muted: var(--color-neutral-300);
		--wp-subtle: var(--color-neutral-400);
		--wp-accent: var(--color-primary-300);
		--wp-link: var(--color-primary-200);
		background: #09090b;
		color: var(--color-neutral-50);
	}
	.wp-hero, .wp-final {
		--wp-muted: var(--color-neutral-50);
		--wp-subtle: var(--color-primary-100);
		--wp-accent: white;
		--wp-link: white;
		--color-surface-border: rgb(255 255 255 / 0.25);
		background: var(--color-accent-purple);
	}
	.wp-hero { position: relative; overflow: hidden; }
	.wp-hero__bg { position: absolute; inset: 0; z-index: 0; opacity: 0.3; pointer-events: none; }
	.wp-hero__bg-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
	.wp-hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 3rem; align-items: center; min-height: min(56rem, 100svh); padding-top: 10rem; padding-bottom: 7rem; }
	.wp-hero__content { min-width: 0; }
	.wp-hero h1 { font-size: clamp(4rem, 5.7vw, 5.5rem); line-height: 1.02; letter-spacing: -0.045em; text-wrap: balance; }
	h1 span { display: block; }
	h1 span + span { color: var(--wp-subtle); }
	.wp-lead { @apply mt-6 text-lg; color: var(--wp-muted); line-height: 1.7; max-width: 44ch; text-wrap: pretty; }
	.wp-actions { @apply mt-8 flex flex-wrap items-center gap-4; }
	.wp-hero__frameworks { margin: 1.25rem 0 0; font-size: 0.875rem; line-height: 1.7; color: var(--wp-muted); }
	.wp-hero__frameworks { padding-top: 1.25rem; border-top: 1px solid var(--color-surface-border); }
	.wp-actions--center { justify-content: center; }
	.wp-hero a:not(.button), .wp-section a, .wp-final a:not(.button) { @apply underline underline-offset-4 transition-colors duration-200 hover:decoration-2; color: var(--wp-link); }
	.wp-story-link { font-weight: 600; }
	.wp-workflow .wp-note { @apply mt-8 text-sm leading-6; color: var(--wp-muted); max-width: 95ch; }
	.wp-workflow .wp-hero__frameworks { font-size: 0.875rem; line-height: 1.7; }
	#demo, #install { scroll-margin-top: 6rem; }
	.wp-demo { min-width: 0; padding: 0.5rem; border-radius: calc(var(--radius-panel) + 0.5rem); background: rgb(255 255 255 / 0.1); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2); }
	.wp-video-wrapper { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--color-surface-border); border-radius: var(--radius-panel); background: var(--color-surface-raised); }
	.wp-video-wrapper iframe { position: absolute; inset: 0; display: block; width: 100%; height: 100%; border: 0; }
	.wp-demo figcaption { margin: 1rem 0.75rem 0.5rem; font-size: 0.8125rem; line-height: 1.6; color: var(--wp-subtle); }
	.wp-steps { list-style: none; margin: 2.5rem 0 0; padding: 0; counter-reset: step; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
	.wp-steps li { position: relative; padding-left: 2.5rem; counter-increment: step; }
	.wp-steps li::before { content: counter(step, decimal-leading-zero); position: absolute; left: 0; top: 0.125rem; color: var(--wp-accent); font-size: 0.8125rem; line-height: 1.75; font-variant-numeric: tabular-nums; }
	.wp-steps h3 { margin: 0 0 0.375rem; font-size: 1.125rem; font-weight: 500; }
	.wp-workflow .wp-steps p { margin: 0; font-size: 1rem; line-height: 1.7; color: var(--wp-muted); }
	.wp-hero :global(a:focus-visible), .wp-final :global(a:focus-visible), .wp-section a:focus-visible, summary:focus-visible, iframe:focus-visible { outline: 3px solid var(--wp-link); outline-offset: 4px; }
	.wp-section { padding: 5rem 0 6rem; }
	.wp-section--raised {
		--wp-muted: var(--color-neutral-600);
		--wp-subtle: var(--color-neutral-600);
		--wp-accent: var(--color-primary-700);
		--wp-link: var(--color-primary-800);
		--color-surface-border: var(--color-neutral-300);
		background: #fafafa;
		color: #09090b;
	}
	.wp-section h2, .wp-section h3 { color: inherit; }
	.wp-section h2, .wp-final h2 { @apply mb-5 text-3xl font-semibold tracking-[-0.03em] md:text-4xl; line-height: 1.15; text-wrap: balance; }
	.wp-section p, .wp-final p { @apply text-lg leading-8; color: var(--wp-muted); max-width: 65ch; text-wrap: pretty; }
	.wp-section .wp-label { @apply text-sm font-medium; color: var(--wp-accent); }
	.wp-story-heading { margin-bottom: 1.25rem; font-size: clamp(1.5rem, 2.5vw, 1.875rem); font-weight: 600; line-height: 1.2; letter-spacing: -0.03em; text-wrap: balance; }
	.wp-section-header { max-width: 44rem; margin-bottom: 2.5rem; }
	.wp-split { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 4rem; align-items: start; }
	.wp-quote { padding-left: 2rem; border-left: 1px solid var(--color-surface-border); }
	.wp-quote blockquote { font-family: var(--font-headings); font-size: clamp(1.5rem, 2.5vw, 1.75rem); line-height: 1.4; letter-spacing: -0.02em; text-wrap: pretty; }
	.wp-quote figcaption { margin-top: 1.5rem; font-size: 0.875rem; font-weight: 600; }
	.wp-quote figcaption span { display: block; margin-top: 0.25rem; font-weight: 400; color: var(--wp-subtle); }
	.wp-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 3rem; align-items: start; }
	.wp-comparison figcaption { margin-bottom: 0.75rem; font-size: 0.875rem; font-weight: 500; color: var(--wp-muted); }
	.wp-comparison img { width: 100%; height: auto; border: 1px solid var(--color-surface-border); border-radius: var(--radius-panel); }
	.wp-section .wp-disclosure { margin-top: 1.5rem; margin-bottom: 0; max-width: 100ch; font-size: 0.8125rem; line-height: 1.7; color: var(--wp-subtle); }
	.wp-capabilities { list-style: none; padding: 0; margin: 0; }
	.wp-capability { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 4rem; padding: 1.75rem 0; border-top: 1px solid var(--color-surface-border); }
	.wp-capability:last-child { border-bottom: 1px solid var(--color-surface-border); }
	.wp-capability h3 { margin: 0; font-size: 1.25rem; font-weight: 500; }
	.wp-capability p { margin: 0; }
	.wp-more-capabilities { margin-top: 1.75rem; line-height: 1.8; color: var(--wp-muted); }
	.wp-more-capabilities summary { cursor: pointer; padding: 0.5rem 0; font-weight: 500; color: var(--color-neutral-50); }
	.wp-more-capabilities ul { list-style: disc; padding-left: 1.5rem; margin-top: 0.75rem; }
	.wp-copy p + p { margin-top: 1.25rem; }
	.wp-install__details { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--color-surface-border); }
	.wp-install__details p { margin: 0; font-size: 0.875rem; line-height: 1.7; }
	.wp-install__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem 1.25rem; margin-top: 0.75rem; font-size: 0.875rem; font-weight: 500; }
	.wp-faqs { margin-top: 1.75rem; border-top: 1px solid var(--color-surface-border); }
	.wp-faq { border-bottom: 1px solid var(--color-surface-border); }
	.wp-faq summary { cursor: pointer; padding: 1.25rem 0; font-weight: 500; transition: color 200ms; }
	.wp-faq summary:hover { color: var(--wp-link); }
	.wp-faq p { margin: 0 0 1.25rem; font-size: 1rem; line-height: 1.75; }
	.wp-final { text-align: center; padding: 5rem 0 6rem; }

	@media (max-width: 1023px) {
		.wp-hero__grid { grid-template-columns: 1fr; gap: 3rem; min-height: auto; padding-top: 9rem; padding-bottom: 5rem; }
		.wp-hero h1 { font-size: clamp(3rem, 7vw, 4.75rem); }
	}

	@media (max-width: 767px) {
		.wp-split, .wp-steps { grid-template-columns: 1fr; gap: 2rem; }
		.wp-hero__grid { padding-top: 8rem; padding-bottom: 3rem; }
		.wp-section, .wp-final { padding: 3.5rem 0 4rem; }
		.wp-quote { padding-left: 1.5rem; }
		.wp-comparison, .wp-capability { grid-template-columns: 1fr; gap: 1.25rem; }
		.wp-capability { gap: 0.5rem; }
	}

	@media (max-width: 639px) {
		.wp-hero__cta :global(.button) { width: 100%; }
	}
</style>
