---
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import gridNetBackground from '../assets/grid-net-background.svg'

const pluginUrl = 'https://wordpress.org/plugins/frontman-agentic-ai-editor/'
const setupGuideUrl = '/docs/integrations/wordpress/'
const taskDemoUrl = '/blog/best-wordpress-ai-plugins-2026/#frontman-workflow-demo'

const SEO = {
	title: 'Ship WordPress Updates Faster | Frontman AI Editor',
	description:
		'Ship updates to your existing WordPress site faster. Describe a change, inspect the page, and refine it with WordPress-native tools beside live preview.'
}

const capabilities = [
	'Create, edit, and delete posts and pages',
	'Insert, update, move, and delete Gutenberg blocks',
	'Edit Elementor pages with Elementor-aware tools',
	'Add and update navigation menu items',
	'Read and change allowlisted settings like title, tagline, and permalinks',
	'Browse and update block templates and template parts',
	'Manage widgets and flush WordPress cache',
	'Work with WooCommerce data when WooCommerce is active'
]

const faqs = [
	{
		question: 'What is Frontman for WordPress?',
		answer:
			'Frontman for WordPress is an AI editor plugin for existing WordPress sites. It adds a Frontman workspace with chat, WordPress-native tools, and live site preview so administrators can describe changes and review the result in context.'
	},
	{
		question: 'How do I install it?',
		answer:
			'Install Frontman Agentic AI Editor from the WordPress Plugin Directory in wp-admin: Plugins > Add New Plugin, search for Frontman Agentic AI Editor, install, activate, then open Frontman from the WordPress admin menu. Sign in to Frontman, arrange service access, and connect your own supported AI provider.'
	},
	{
		question: 'Does it work with Elementor?',
		answer:
			'Yes. Frontman includes Elementor-aware tools for inspecting and editing Elementor-backed pages, while keeping the page preview visible during the workflow.'
	},
	{
		question: 'Can I use it on production?',
		answer:
			'Yes. Frontman for WordPress is production-ready. Writes affect the connected installation, so published content on a live site can change immediately. Use staging for higher-risk work, keep backups, and inspect the resulting page. Recovery depends on the type of change.'
	},
	{
		question: 'Who can access Frontman in WordPress?',
		answer:
			'Only WordPress users with the manage_options capability can access Frontman. Tool requests are protected with WordPress nonces, and site option writes are restricted to allowlisted settings.'
	}
]

const pageJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'SoftwareSourceCode',
			name: 'Frontman for WordPress',
			description: SEO.description,
			url: 'https://frontman.sh/',
			codeRepository: 'https://github.com/frontman-ai/frontman',
			license: 'https://spdx.org/licenses/GPL-2.0-or-later.html',
			runtimePlatform: 'WordPress',
			sameAs: [pluginUrl, 'https://github.com/frontman-ai/frontman']
		},
		{
			'@type': 'FAQPage',
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: faq.answer
				}
			}))
		}
	]
}
---

<Layout
	title={SEO.title}
	description={SEO.description}
	ogImage="/blog/frontman-wordpress-plugin-released-cover.png"
	ogImageWidth={1200}
	ogImageHeight={450}
	ogImageAlt="Frontman WordPress Plugin Released"
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />

	<section class="wp-hero">
		<div class="wp-hero__bg">
			<img src={gridNetBackground.src} alt="Decorative grid background" aria-hidden="true" class="wp-hero__bg-image" width="1440" height="900" fetchpriority="high" />
		</div>
		<div class="wp-container wp-container--wide wp-hero__grid">
			<div class="wp-hero__content">
				<p class="wp-label">Frontman for WordPress</p>
				<h1>Ship WordPress updates faster.</h1>
				<p class="wp-lead">
					Update the WordPress site you already have without translating every request into builder controls or another implementation handoff. Describe one change, inspect the page, and refine the result.
				</p>
				<div class="wp-actions wp-hero__cta">
					<Button size="lg" style="white" link={pluginUrl} classes="wp-primary-cta" data-ga-event="click_wordpress_plugin" data-ga-category="conversion" data-ga-label="wordpress_home_hero">Install from WordPress.org <span class="wp-cta-arrow" aria-hidden="true">→</span></Button>
					<Button size="lg" style="white" variation="outline" link="#demo" data-ga-event="click_demo_navigation" data-ga-category="engagement" data-ga-label="wordpress_home_hero">See a WordPress task <span class="wp-cta-arrow" aria-hidden="true">→</span></Button>
				</div>
				<p class="wp-hero__support">Your existing site. Gutenberg and Elementor. No rebuild.</p>
			</div>
			<figure id="demo" class="wp-video-wrapper">
				<video controls preload="metadata" poster="/blog/frontman-wordpress-editor-demo-poster.webp" width="520" height="350" aria-label="Frontman changing a WordPress FAQ heading beside live preview">
					<source src="/blog/frontman-wordpress-editor-demo.mp4" type="video/mp4" />
					<a href="/blog/frontman-wordpress-editor-demo.mp4">Watch the WordPress FAQ-heading edit.</a>
				</video>
				<figcaption>WordPress task demo: Frontman changes one FAQ heading beside the page preview. This is an editing example, not a timed benchmark or deployment.</figcaption>
				<a href={taskDemoUrl} class="wp-secondary-link">Read the task walkthrough</a>
			</figure>
			<p class="wp-note">Production-ready. Start with a staging copy and a backup. Requires WordPress 6.0+, PHP 7.4+, administrator access, Frontman sign-in and service access, plus separate <a href="/docs/api-keys/" class="wp-copy-link">AI-provider access and costs</a>. See <a href="/pricing/" class="wp-copy-link">pricing</a>.</p>
		</div>
	</section>

	<section class="wp-section wp-section--dark">
		<div class="wp-container">
			<h2>You know the update. Getting it onto the page is the bottleneck.</h2>
			<p>
				A new headline can mean finding the right Gutenberg block, Elementor widget, or person to implement it. Frontman uses WordPress-native tools beside the page preview so you can work from the outcome, not just the field name.
			</p>
		</div>
	</section>

	<section class="wp-section wp-section--light">
		<div class="wp-container">
			<div class="wp-section-header">
				<p class="wp-label wp-label--dark">Workflow</p>
				<h2>Describe. Inspect. Refine.</h2>
			</div>
			<div class="wp-steps">
				<div class="wp-step"><span>1</span><h3>Describe one update</h3><p>Ask for a bounded change on the page you want to update. Select an element when it helps clarify the request.</p></div>
				<div class="wp-step"><span>2</span><h3>Inspect the page</h3><p>Check the changed content and layout in preview. WordPress writes already affect the connected installation.</p></div>
				<div class="wp-step"><span>3</span><h3>Refine the result</h3><p>Ask for a focused adjustment, then check the page at the screen sizes your visitors use.</p></div>
			</div>
			<a href="/blog/autonomyai-wordpress-redesign-case-study/" class="wp-demo-link" data-ga-event="click_customer_story" data-ga-category="engagement" data-ga-label="wordpress_home_workflow">Read how AutonomyAI's marketing lead redesigned its existing Elementor site with Frontman.</a>
			<p>Frontman-authored customer report, not a controlled speed or cost comparison.</p>
		</div>
	</section>

	<section class="wp-section wp-section--dark">
		<div class="wp-container">
			<div class="wp-section-header">
				<p class="wp-label">Everyday updates</p>
				<h2>Start with one job on your existing site.</h2>
			</div>
			<div class="wp-capabilities">
				<div class="wp-capability"><h3>Headline and CTA copy</h3><p>Replace a stale message or clarify the next action.</p></div>
				<div class="wp-capability"><h3>A Gutenberg or Elementor section</h3><p>Update content or adjust a section without rebuilding the site.</p></div>
				<div class="wp-capability"><h3>Navigation</h3><p>Add or update a menu item, then check its destination.</p></div>
			</div>
			<details class="wp-more-capabilities">
				<summary>More WordPress capabilities</summary>
				<ul>{capabilities.map((capability) => <li>{capability}</li>)}</ul>
			</details>
		</div>
	</section>

	<section id="install" class="wp-section wp-section--light">
		<div class="wp-container wp-split">
			<div>
				<p class="wp-label wp-label--dark">Setup</p>
				<h2>Connect the site before your first edit.</h2>
			</div>
			<div class="wp-install">
				<ol class="wp-install__steps" role="list">
					<li>
						<h3>Install the plugin</h3>
						<p>In wp-admin, go to Plugins → Add New Plugin. Search for Frontman Agentic AI Editor, install, and activate.</p>
					</li>
					<li>
						<h3>Sign in to Frontman</h3>
						<p>Open Frontman from the WordPress admin menu and sign in with GitHub or Google.</p>
					</li>
					<li>
						<h3>Connect your AI provider</h3>
						<p>Arrange Frontman service access and connect a supported AI provider. Provider access and costs are separate.</p>
					</li>
				</ol>
				<div class="wp-install__details">
					<p><strong>Requirements</strong> · WordPress 6.0+ · PHP 7.4+ · Administrator access</p>
					<div class="wp-install__links">
						<a href={setupGuideUrl}>WordPress setup guide</a>
						<a href="/pricing/">Pricing</a>
						<a href="/docs/api-keys/">Provider connection guide</a>
					</div>
					<p>Using Next.js, Astro, or Vite? <a href="/frameworks/#install" data-ga-event="click_framework_setup" data-ga-category="conversion" data-ga-label="wordpress_home_setup">Framework setup →</a><br />Developers review, test, and deploy source changes.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="wp-section wp-section--dark">
		<div class="wp-container wp-split">
			<div>
				<p class="wp-label">Safety</p>
				<h2>Know what changes immediately.</h2>
			</div>
			<div class="wp-copy">
				<p>Frontman for WordPress is production-ready. Writes persist to the connected WordPress installation. Published content on a live site can change immediately; preview is not a universal approval gate. Draft publication and staging promotion still use your normal process.</p>
				<p>Only administrators can access it. Tool requests use WordPress nonces. Site option writes are restricted to allowlisted settings. Keep backups and use staging for higher-risk work. Recovery is selective: Elementor snapshots and applicable WordPress revisions help with some changes, but there is no universal undo.</p>
				<p>Use our <a href="/blog/wordpress-maintenance-checklist/" class="wp-copy-link">risk-based WordPress maintenance checklist</a> to turn staging, backup, verification, and recovery advice into a recurring operating process.</p>
			</div>
		</div>
	</section>

	<section class="wp-section wp-section--light">
		<div class="wp-container">
			<p class="wp-label wp-label--dark">FAQ</p>
			<h2>Common questions</h2>
			<div class="wp-faqs">
				{faqs.map((faq) => (
					<details class="wp-faq">
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="wp-final">
		<div class="wp-container wp-narrow">
			<h2>Install Frontman for WordPress.</h2>
			<p>Search for Frontman Agentic AI Editor in wp-admin, or open the Plugin Directory page.</p>
			<div class="wp-actions wp-actions--center">
				<Button size="lg" style="white" link={pluginUrl} data-ga-event="click_wordpress_plugin" data-ga-category="conversion" data-ga-label="wordpress_home_final">Install from WordPress.org</Button>
				<a href="/docs/integrations/wordpress/" class="wp-secondary-link">Setup guide</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	@reference "../styles/global.css";

	.wp-container { @apply mx-auto max-w-6xl px-6; }
	.wp-container--wide { max-width: 1100px; }
	.wp-narrow { max-width: 760px; }
	.wp-label { @apply mb-3 font-mono text-sm uppercase tracking-[0.14em]; color: #c4b5fd; }
	.wp-label--dark { color: #7c3aed; }
	.wp-hero { position: relative; overflow: hidden; background: #7c3aed; color: #fafafa; }
	.wp-hero__bg { position: absolute; inset: 0; z-index: 0; opacity: 0.3; }
	.wp-hero__bg-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
	.wp-hero__grid { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; padding-top: 104px; padding-bottom: 80px; }
	.wp-hero__content { max-width: 780px; text-align: center; display: flex; flex-direction: column; align-items: center; }
	h1 { width: 100%; text-align: center; font-family: 'SF Pro Display', system-ui, helvetica, sans-serif; font-size: clamp(32px, 4vw, 52px); line-height: 1.12; font-weight: 700; letter-spacing: -0.035em; color: white; }
	.wp-headline__setup, .wp-headline__payoff { display: block; font-size: inherit; line-height: inherit; font-weight: inherit; text-wrap: pretty; }
	.wp-headline__setup { margin-bottom: 8px; }
	.wp-lead { @apply mt-6 text-lg text-white; line-height: 1.55; max-width: 620px; text-wrap: pretty; }
	.wp-actions { @apply mt-8 flex flex-wrap items-center gap-4; }
	.wp-hero__cta { justify-content: center; gap: 20px; }
	.wp-hero__cta .button { justify-content: center; }
	.wp-primary-cta { min-width: 268px; }
	.wp-hero__support { margin-top: 20px; font-size: 14px; line-height: 1.6; }
	.wp-cta-arrow { margin-left: 8px; }
	.wp-actions--center { justify-content: center; }
	.wp-secondary-link { @apply font-semibold text-white underline underline-offset-4 hover:text-primary-100; }
	.wp-note { @apply mt-6 text-sm leading-6 text-white; }
	.wp-note a { color: inherit; text-decoration: underline; text-underline-offset: 4px; }
	#demo, #install { scroll-margin-top: 100px; }
	.wp-video-wrapper { width: 100%; max-width: 520px; margin: 40px auto 0; }
	.wp-video-wrapper video { display: block; width: 100%; height: auto; border-radius: 12px; }
	.wp-video-wrapper figcaption { margin: 16px 0; font-size: 14px; line-height: 1.6; }
	.wp-hero .wp-label { color: white; }
	.wp-hero :global(a:focus-visible), .wp-final :global(a:focus-visible), video:focus-visible { outline: 3px solid white; outline-offset: 4px; }
	.wp-section a:focus-visible, summary:focus-visible { outline: 3px solid #7c3aed; outline-offset: 4px; }
	.wp-copy ol { list-style: decimal; padding-left: 24px; margin-bottom: 18px; line-height: 1.8; }
	.wp-more-capabilities { margin-top: 28px; line-height: 1.8; }
	.wp-more-capabilities summary { cursor: pointer; font-weight: 700; }
	.wp-more-capabilities ul { list-style: disc; padding-left: 24px; }
	.wp-capability h3 { font-weight: 700; margin-bottom: 8px; }
	.wp-section { padding: 80px 0; }
	.wp-section--dark { background: #09090b; color: #fafafa; }
	.wp-section--light { background: #fafafa; color: #09090b; }
	.wp-section--light a { color: #5b21b6; text-decoration: underline; text-underline-offset: 4px; }
	.wp-section--dark a { color: #ddd6fe; text-decoration: underline; text-underline-offset: 4px; }
	.wp-section--dark a:focus-visible { outline-color: #ddd6fe; }
	.wp-section h2 { @apply mb-5 text-3xl font-bold tracking-[-0.03em] md:text-5xl; line-height: 1.08; color: inherit; opacity: 1; }
	.wp-section p { @apply text-lg leading-8; color: inherit; opacity: 0.78; }
	.wp-section-header { max-width: 760px; margin-bottom: 36px; }
	.wp-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
	.wp-step { border: 2px solid #111827; border-radius: 20px; padding: 24px; background: white; box-shadow: 6px 6px 0 #111827; }
	.wp-step span { display: inline-flex; width: 34px; height: 34px; align-items: center; justify-content: center; border-radius: 999px; background: #7c3aed; color: white; font-weight: 800; margin-bottom: 18px; }
	.wp-step h3 { @apply mb-2 text-xl font-bold text-slate-950; }
	.wp-step p { @apply text-base leading-7 text-slate-600; opacity: 1; }
	.wp-demo-link { @apply mt-8 inline-flex items-center gap-2 font-semibold text-violet-700 underline decoration-2 underline-offset-4 hover:text-violet-900; }
	.wp-capabilities { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
	.wp-capability { border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 18px; background: rgba(255,255,255,0.04); color: #e4e4e7; }
	.wp-split { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 56px; align-items: start; }
	.wp-copy p + p { margin-top: 18px; }
	.wp-install__steps { list-style: none; margin: 0; padding: 0; counter-reset: install-step; display: grid; gap: 24px; }
	.wp-install__steps li { position: relative; padding-left: 48px; counter-increment: install-step; }
	.wp-install__steps li::before { content: counter(install-step); position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: #ede9fe; color: #5b21b6; font-size: 14px; font-weight: 700; }
	#install .wp-install__steps h3 { color: #09090b; margin: 0 0 4px; font-size: 18px; line-height: 30px; font-weight: 700; }
	.wp-install__steps p { margin: 0; font-size: 16px; line-height: 1.6; opacity: 1; color: #52525b; }
	.wp-install__details { margin-top: 28px; padding-top: 20px; border-top: 1px solid #d4d4d8; }
	.wp-install__details p { margin: 0; font-size: 14px; line-height: 1.7; opacity: 1; color: #52525b; }
	.wp-install__links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 12px 0 18px; font-size: 14px; font-weight: 600; }
	.wp-faqs { margin-top: 28px; border-top: 1px solid #d4d4d8; }
	.wp-faq { border-bottom: 1px solid #d4d4d8; padding: 18px 0; }
	.wp-faq summary { cursor: pointer; font-weight: 700; color: #09090b; }
	.wp-faq p { @apply mt-3 text-base leading-7 text-slate-600; opacity: 1; }
	.wp-final { background: #7c3aed; color: white; text-align: center; padding: 72px 0; }
	.wp-final h2 { @apply mb-4 text-4xl font-bold tracking-[-0.03em] md:text-5xl; }
	.wp-final p { @apply text-lg text-violet-100; }

	@media (max-width: 900px) {
		.wp-split, .wp-steps, .wp-capabilities { grid-template-columns: 1fr; }
		.wp-hero__grid { padding-top: 96px; padding-bottom: 56px; }
		.wp-video-wrapper { margin-top: 28px; }
	}

	@media (max-width: 639px) {
		.wp-hero__cta .button { width: 100%; }
	}
</style>
