---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'
import Button from '../components/ui/Button.astro'
import HomeFAQ from '../components/blocks/FAQ/HomeFAQ.astro'
import FinalCTA from '../components/blocks/CTA/FinalCTA.astro'
import gridNetBackground from '../assets/grid-net-background.svg'

const SEO = {
	title: 'Frontman Pro Pricing | AI Frontend Editing',
	description:
		'Frontman Pro pricing for visual AI frontend editing: €15 per seat/month, 14-day free trial, BYOK AI billing, and free self-hosting while available.'
}


const planFeatures = [
	'Visual AI editing in your browser',
	'Changes your developers can review and ship',
	'Live page context for more accurate edits',
	'Unlimited projects within one organization',
	'Your AI provider, billed separately'
]


const faqs = [
	{
		question: 'Can I cancel during the trial?',
		answer:
			'Yes. Cancel before day 14 to avoid billing. A credit card is required to start the trial.'
	},
	{
		question: 'What does one seat include?',
		answer:
			'One user can use Frontman Pro across unlimited projects within one organization.'
	},
	{
		question: 'Are AI costs included?',
		answer:
			'No. Bring your own AI provider key. Your provider bills usage separately, so you control your model and AI spend.'
	},
	{
		question: 'Do changes go live automatically?',
		answer:
			'No. Frontman edits your project files. Your team reviews and ships changes through Git as usual.'
	},
	{
		question: 'Can I self-host for free?',
		answer:
			'Yes. You manage setup, hosting, and updates, and pay your infrastructure and AI provider costs.'
	}
]

const pricingJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			name: SEO.title,
			description: SEO.description,
			url: 'https://frontman.sh/pricing/'
		},
		{
			'@type': 'Service',
			name: 'Frontman Pro',
			serviceType: 'AI frontend editing subscription',
			provider: {
				'@type': 'Organization',
				name: 'Frontman',
				url: 'https://frontman.sh/'
			},
			url: 'https://frontman.sh/pricing/',
			offers: [
				{
					'@type': 'Offer',
					name: 'Frontman Pro monthly seat',
					price: '15',
					priceCurrency: 'EUR',
					availability: 'https://schema.org/InStock',
					url: 'https://frontman.sh/pricing/',
					category: 'subscription',
					description: 'Hosted Frontman Pro seat billed monthly. AI provider usage is billed separately.'
				},
				{
					'@type': 'Offer',
					name: 'Frontman Pro yearly seat',
					price: '150',
					priceCurrency: 'EUR',
					availability: 'https://schema.org/InStock',
					url: 'https://frontman.sh/pricing/',
					category: 'subscription',
					description: 'Hosted Frontman Pro seat billed yearly. AI provider usage is billed separately.'
				}
			]
		},
		{
			'@type': 'FAQPage',
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: faq.answer
				}
			}))
		}
	]
}

const darkSectionClass = 'bg-neutral-950'
const checkItemClass =
	"relative pl-7 text-neutral-200 before:absolute before:left-0 before:top-1 before:h-4 before:w-4 before:rounded-full before:bg-primary-300/20 before:text-center before:text-[10px] before:leading-4 before:text-primary-100 before:content-['✓']"
const panelClass = 'rounded-3xl border'
const ctaButtonClass = 'mt-8 w-full sm:w-auto'
---

<Layout title={SEO.title} description={SEO.description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(pricingJsonLd)} />
	<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
			const billingToggleButtons = document.querySelectorAll('[data-billing-toggle]')
			const priceAmount = document.querySelector('[data-price-amount]')
			const pricePeriod = document.querySelector('[data-price-period]')
			const priceNote = document.querySelector('[data-price-note]')
			const activeBillingClass = 'cursor-pointer whitespace-nowrap rounded-full bg-white px-4 py-2 text-sm font-bold text-primary-700 shadow-sm'
			const inactiveBillingClass = 'cursor-pointer whitespace-nowrap rounded-full px-4 py-2 text-sm font-bold text-white/70 transition-colors hover:text-white'
			const billingPlans = {
				monthly: {
					amount: '15',
					period: 'per seat / month',
					note: 'Billed monthly. Switch to yearly to save 17% per seat.'
				},
				yearly: {
					amount: '12.50',
					period: 'per seat / month',
					note: '€150 per seat billed yearly. Save €30 a year — 2 months free.'
				}
			}

			const setBillingPlan = (button) => {
				const selectedBilling = button.getAttribute('data-billing-toggle')
				const selectedPlan = billingPlans[selectedBilling]

				priceAmount.textContent = selectedPlan.amount
				pricePeriod.textContent = selectedPlan.period
				priceNote.textContent = selectedPlan.note

				billingToggleButtons.forEach((toggleButton) => {
					const isActive = toggleButton === button
					toggleButton.className = isActive ? activeBillingClass : inactiveBillingClass
					toggleButton.setAttribute('aria-pressed', isActive ? 'true' : 'false')
				})
			}

			billingToggleButtons.forEach((button) => {
				button.addEventListener('click', () => setBillingPlan(button))
			})

		})
	</script>

	<div class="pricing-content">
	<Section classes="pricing-hero bg-primary-500" padding="none">
		<div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.12]">
			<img src={gridNetBackground.src} alt="Decorative grid background" aria-hidden="true" class="h-full w-full object-cover object-center" width="1440" height="900" />
		</div>
		<Row classes="relative z-10">
			<Col span="10" classes="lg:col-start-2">
				<div class="relative mx-auto max-w-5xl text-center">
					<h1 class="pricing-hero-title">Simple pricing for reviewable frontend code changes.</h1>
					<p class="pricing-hero-subtitle">
						Frontman Pro helps designers, PMs, and product teams turn visual requests into source-file edits your developers can review and ship.
					</p>
					<div class="mt-8 flex flex-wrap justify-center gap-3" aria-label="Pricing highlights">
						<span class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-primary-950/20 backdrop-blur">14-day free trial</span>
					</div>
				</div>
			</Col>
		</Row>
	</Section>

	<Section id="plans" classes={darkSectionClass} padding="bottom">
		<Row classes="relative z-10 gap-y-6 pt-12 lg:pt-16">
			<Col span="8" classes="lg:col-start-3">
				<div class={`${panelClass} relative overflow-hidden border-primary-300/40 bg-primary-800 p-6 text-white shadow-2xl shadow-primary-950/30 md:p-8`}>
					<div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-white/15 blur-3xl"></div>
					<div class="relative flex flex-wrap items-start justify-between gap-4">
						<div class="min-w-0 w-full sm:flex-1">
							<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-white/75">Frontman Pro</p>
							<h2 class="block text-3xl leading-tight text-white lg:text-4xl">The simple hosted plan</h2>
						</div>
						<p class="rounded-full border border-white/25 bg-white/15 px-3 py-1 text-sm font-bold text-white">Most teams</p>
					</div>
					<p class="relative mt-4 max-w-2xl text-lg leading-relaxed text-white">
						For product teams that want visual AI frontend editing without running infrastructure.
					</p>
					<div class="mt-6 inline-flex w-fit max-w-full rounded-full border border-white/20 bg-primary-700/25 p-1" aria-label="Billing frequency" data-billing-toggle-group>
						<button type="button" class="cursor-pointer whitespace-nowrap rounded-full bg-white px-4 py-2 text-sm font-bold text-primary-700 shadow-sm" data-billing-toggle="monthly" aria-pressed="true">Monthly</button>
						<button type="button" class="cursor-pointer whitespace-nowrap rounded-full px-4 py-2 text-sm font-bold text-white/70 transition-colors hover:text-white" data-billing-toggle="yearly" aria-pressed="false">Yearly · save 17%</button>
					</div>
					<div class="mt-7 rounded-[1.25rem] border border-white/20 bg-white/10 p-4 shadow-inner shadow-primary-950/20 sm:p-5">
						<div class="flex flex-wrap items-end gap-x-4 gap-y-2">
							<div class="flex flex-wrap items-end gap-x-4">
								<span class="inline-flex items-start gap-x-1">
									<span class="pt-3 text-3xl font-bold leading-none text-white">€</span>
									<span class="text-6xl font-black leading-none tracking-[-0.06em] text-white md:text-8xl" data-price-amount>15</span>
								</span>
							</div>
							<p class="text-lg font-bold leading-none text-white/90" data-price-period>per seat / month</p>
						</div>
						<p class="mt-4 text-sm font-semibold text-white" data-price-note>Billed monthly. Switch to yearly to save 17% per seat.</p>
					</div>
					<Button type="link" link="/frameworks/#install" size="lg" style="white" classes={ctaButtonClass}>Start your 14-day trial</Button>
					<p class="mt-4 text-sm leading-relaxed text-white/70">Credit card required. Cancel before day 14. We’ll send a reminder before billing. Taxes calculated at checkout.</p>
					<ul class="mt-6 grid gap-3 border-t border-white/20 pt-6">
						{planFeatures.map((feature) => <li class={checkItemClass}>{feature}</li>)}
					</ul>
				</div>
			</Col>
			<Col span="8" classes="lg:col-start-3">
				<div class={`${panelClass} self-hosting-panel border-white/10 bg-white/[0.04] p-6 md:p-8`}>
					<div class="self-hosting-header">
						<h2>Self-hosting</h2>
						<span class="rounded-full border border-primary-300/25 bg-primary-400/10 px-3 py-1 text-sm font-semibold text-primary-200">Free</span>
					</div>
					<p class="self-hosting-intro">For technical teams that prefer to run Frontman on their own infrastructure.</p>
					<div class="self-hosting-details">
						<ul class="grid gap-3 sm:grid-cols-3">
							<li class={checkItemClass}>Your infrastructure</li>
							<li class={checkItemClass}>Your setup & updates</li>
							<li class={checkItemClass}>Your AI provider key</li>
						</ul>
						<p class="self-hosting-note">Hosted support, uptime, and onboarding are not included.</p>
					</div>
				</div>
			</Col>
		</Row>
	</Section>



	<nav aria-label="Pricing legal documents" class="flex flex-wrap justify-center gap-6 px-6 pb-8 text-sm">
		<a href="/terms/">Terms</a>
		<a href="/privacy/">Privacy</a>
		<a href="/dpa/">DPA</a>
	</nav>

	<HomeFAQ
		faqs={faqs.map(({ question, answer }) => ({ question, reply: answer }))}
		title="Simple answers about Frontman pricing"
		subtitle="The details on seats, your free trial, self-hosting, and AI billing."
	/>

	<FinalCTA
		link="/frameworks/#install"
		title="One simple hosted plan. 14-day free trial."
		description="Cancel before billing. Bring your own AI key. Give your developers reviewable source-file diffs."
		buttonLabel="Start your 14-day trial"
	/>
	</div>
</Layout>

<style>
	:global(#plans .self-hosting-header) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	:global(#plans .self-hosting-panel h2) {
		flex: 1 0 200px;
		margin: 0;
		font-size: 28px;
		line-height: 1.2;
	}

	:global(#plans .self-hosting-intro) {
		margin: 16px 0 24px;
		color: var(--color-neutral-300);
		font-size: 16px;
		line-height: 1.6;
	}

	:global(#plans .self-hosting-details) {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		padding-top: 24px;
	}

	:global(#plans .self-hosting-note) {
		margin: 20px 0 0;
		color: var(--color-neutral-400);
		font-size: 14px;
		line-height: 1.6;
	}

	:global(#plans [data-billing-toggle][aria-pressed='false']) {
		background: transparent;
		color: rgba(255, 255, 255, 0.85);
	}

	.pricing-content :global([data-billing-toggle][aria-pressed='true']) {
		background: white;
		color: var(--color-primary-700);
	}

	.pricing-content :global(.pricing-hero) {
		padding: 104px 0 64px;
	}

	.pricing-hero-title {
		max-width: 780px;
		margin: 24px auto 20px;
		font-family: 'SF Pro Display', system-ui, helvetica, sans-serif;
		font-size: clamp(36px, 5.2vw, 60px);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.04em;
		text-wrap: balance;
		color: white;
	}

	.pricing-hero-subtitle {
		max-width: 600px;
		margin: 0 auto;
		font-size: 18px;
		line-height: 27px;
		color: rgba(255, 255, 255, 0.85);
		text-wrap: pretty;
	}

	.pricing-content :global(.section h2) {
		font-size: clamp(28px, 3vw, 40px);
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.pricing-content :global(.section h3) {
		font-size: 24px;
		line-height: 1.3;
	}

	@media (max-width: 639px) {
		.pricing-content :global(.pricing-hero) {
			padding: 96px 0 48px;
		}

		.pricing-hero-subtitle {
			font-size: 15px;
			line-height: 24px;
		}
	}
</style>

