---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/blocks/hero/HomeCTA.astro'
import FeatureHighlights from '../components/blocks/features/FeatureHighlights.astro'
import FrameworkSupport from '../components/blocks/frameworks/FrameworkSupport.astro'

import InstallSteps from '../components/blocks/install/InstallSteps.astro'
import HomeFAQ from '../components/blocks/FAQ/HomeFAQ.astro'
import FinalCTA from '../components/blocks/CTA/FinalCTA.astro'

const faqs = [
	{
		question: 'What do I need before my first framework edit?',
		reply: 'A developer installs Frontman in a running supported Next.js, Astro, or Vite environment with permitted workspace access. Sign in to Frontman, arrange service access, and connect a supported AI provider. Provider access and costs are separate.'
	},
	{
		question: 'How do changes reach production?',
		reply: 'Frontman edits source files in the connected development workspace. Your team reviews the diff, runs tests, and deploys through its normal Git workflow. Check integration guards, built artifacts, and deployed routes when Frontman must be absent from production.'
	},
	{
		question: 'Can I use Frontman with WordPress instead?',
		reply: 'Yes. Use the WordPress plugin path at frontman.sh and open Frontman from the admin menu. WordPress writes persist to the connected installation; published content on a live site can change immediately. Start with staging and backups.'
	}
]

const SEO = {
	title: 'Ship Framework Website Updates Faster | Frontman',
	description:
		'Ship updates to existing Next.js, Astro, and Vite websites faster. Work in a supported development environment and give developers source changes to review, test, and deploy.'
}

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqs.map((faq) => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.reply
		}
	}))
}

---

<Layout title={SEO.title} description={SEO.description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
	<Hero />
	<section id="site-type" class="bg-neutral-950 px-6 py-14 text-neutral-100">
		<div class="mx-auto max-w-5xl">
			<div class="mx-auto max-w-2xl text-center">
				<p class="font-mono text-sm uppercase tracking-[0.14em] text-primary-300">Choose your path</p>
				<h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">What kind of site do you maintain?</h2>
				<p class="mt-4 text-base leading-7 text-neutral-300">Frontman keeps one promise across both workflows: update the site you already have from the page you can see.</p>
			</div>
			<div class="mt-10 grid gap-5 md:grid-cols-2">
				<a href="/" class="group rounded-3xl border border-white/10 bg-white/[0.04] p-7 no-underline transition hover:border-primary-300/60 hover:bg-primary-500/[0.08]">
					<p class="font-mono text-sm uppercase tracking-[0.12em] text-primary-300">WordPress site owners</p>
					<h3 class="mt-4 text-2xl font-semibold text-white">Edit WordPress beside your live site</h3>
					<p class="mt-3 text-base leading-7 text-neutral-300">Update posts, pages, Gutenberg blocks, Elementor layouts, menus, media, settings, and WooCommerce data without hunting through wp-admin.</p>
					<span class="mt-6 inline-flex font-semibold text-primary-200 group-hover:text-primary-100">Install WordPress plugin &rarr;</span>
				</a>
				<a href="/marketing-teams/#developer-setup" data-ga-event="click_developer_setup" data-ga-category="conversion" data-ga-label="frameworks_site_type" class="group rounded-3xl border border-white/10 bg-white/[0.04] p-7 no-underline transition hover:border-primary-300/60 hover:bg-primary-500/[0.08]">
					<p class="font-mono text-sm uppercase tracking-[0.12em] text-primary-300">Marketing and design teams</p>
					<h3 class="mt-4 text-2xl font-semibold text-white">Turn site requests into reviewable changes</h3>
					<p class="mt-3 text-base leading-7 text-neutral-300">Use Frontman on Next.js, Astro, and Vite sites so marketers and designers can click the page, request changes, and hand developers a normal diff.</p>
					<span class="mt-6 inline-flex font-semibold text-primary-200 group-hover:text-primary-100">Get developer setup &rarr;</span>
				</a>
			</div>
		</div>
	</section>
	<InstallSteps />
	<section id="agent-readiness" class="bg-neutral-950 px-6 py-12 text-neutral-100">
		<div class="mx-auto max-w-5xl">
			<div>
				<h2 class="text-3xl font-semibold tracking-tight text-white">What is Frontman?</h2>
				<p class="mt-4 text-base leading-7 text-neutral-300">Frontman is an AI website editor for existing sites. It runs inside WordPress or your framework dev server, reads the live page plus CMS or source context, then turns visual requests into reviewable website updates.</p>
				<h3 class="mt-8 text-xl font-semibold text-white">Why it works better than tickets</h3>
				<p class="mt-3 text-base leading-7 text-neutral-300">Website requests usually start with screenshots and vague descriptions. Frontman starts from the page itself: selected elements, computed styles, source mappings, routes, logs, and live preview feedback. That context helps the agent change the right thing with less back-and-forth.</p>
			</div>
		</div>
	</section>
	<FeatureHighlights />
	<FrameworkSupport />

	<section class="bg-neutral-950 px-6 py-10 text-center text-neutral-300">
		<p class="mx-auto max-w-3xl text-base leading-relaxed">
			Comparing AI tools for UI work? Read the <a href="/blog/best-frontend-coding-agent/" class="font-semibold text-primary-300 underline underline-offset-4 hover:text-primary-200">frontend coding agent</a> guide for Cursor, GitHub Copilot, Claude Code, v0, Bolt.new, Kombai, Stagewise, and Frontman.
		</p>
	</section>

	<HomeFAQ faqs={faqs} subtitle="Setup, source output, and publication boundaries." />
	<FinalCTA title="Move from request to source change." description="Start with one update in your development environment. Inspect the page, review the source diff, and test and deploy through your team’s normal workflow." buttonLabel="Install Frontman" />
</Layout>
