---
import ToolsLayout from '../../layouts/ToolsLayout.astro'
---

<ToolsLayout
	title="Free marketing tools"
	description="A home for independent utilities that help you prepare website content and campaign materials."
	noindex={true}
>
	<p slot="disclosure" class="mt-4 text-sm leading-6 text-neutral-300">
		These utilities will not require a Frontman account or a connection to your WordPress site.
	</p>

	<section aria-labelledby="tools-availability" class="border-t border-neutral-800 py-8">
		<h2 id="tools-availability" class="text-xl md:text-2xl">No tools are available yet</h2>
		<p class="max-w-2xl leading-7 text-neutral-300">
			This directory is being prepared. It will list tools only when they are ready to use.
		</p>
	</section>
</ToolsLayout>
