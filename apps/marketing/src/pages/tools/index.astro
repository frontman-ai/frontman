---
import ToolsLayout from '../../layouts/ToolsLayout.astro'
---

<ToolsLayout
	title="Free marketing tools"
	description="Check which Frontman integration works with your website or app."
>
	<p slot="disclosure" class="mt-4 text-sm leading-6 text-neutral-300">
		You can use these tools without a Frontman account.
	</p>

	<section aria-labelledby="tools-availability" class="border-t border-neutral-800 py-8">
		<h2 id="tools-availability" class="text-xl md:text-2xl">
			<a class="underline" href="/tools/framework-compatibility/">Frontman compatibility lookup</a>
		</h2>
		<p class="max-w-2xl leading-7 text-neutral-300">
			Check version requirements for Next.js, Astro, Vite, and WordPress. Download the matrix as JSON.
		</p>
	</section>
</ToolsLayout>
