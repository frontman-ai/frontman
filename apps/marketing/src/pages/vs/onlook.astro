---

import ComparisonLayout from '../../layouts/ComparisonLayout.astro'
import { createComparisonReview, frontmanLicenseShort } from '../../content/frontmanFacts'
import type {
  ComparisonFeature,
  ComparisonReview,
  CompetitorInfo,
  FAQ,
  SEOInfo,
} from '../../layouts/ComparisonLayout.astro'

const seo: SEOInfo = {
  title: 'Onlook vs Frontman: Visual Editing for Existing Apps',
  description:
    'Compare Onlook’s desktop design canvas with Frontman’s browser annotations. See how both tools edit an existing codebase and what each workflow requires.',
}

const review: ComparisonReview = {
  ...createComparisonReview([
    { label: 'Onlook desktop workflow and requirements', url: 'https://github.com/onlook-dev/onlook#readme' },
    { label: 'Onlook source license', url: 'https://github.com/onlook-dev/onlook/blob/main/LICENSE' },
  ]),
  checkedAt: '2026-11-20',
}

const competitor: CompetitorInfo = {
  name: 'Onlook',
  slug: 'onlook',
  url: 'https://www.onlook.com/',
  category: 'DeveloperApplication',
  description: 'Local-first desktop design canvas that runs your app and connects to Claude Code or ChatGPT/Codex.',
  pricing: {
    cost: 'Free editor',
    model: 'Bring your own agent',
    features: [
      'Connect your Claude Code or ChatGPT/Codex account for agent edits',
      'Onlook’s source code is Apache-2.0; some assets have separate terms',
    ],
  },
}

const features: ComparisonFeature[] = [
  { name: 'Edits an existing app’s source', frontman: 'yes', competitor: 'yes', frontmanNote: 'Works through the local framework integration', competitorNote: 'Runs the project’s dev server from a local Git worktree' },
  { name: 'Point at a rendered element for an AI edit', frontman: 'yes', competitor: 'yes', frontmanNote: 'Annotate an element in the browser preview', competitorNote: 'Select an element on the canvas and use inline chat' },
  { name: 'Design canvas with viewport frames side by side', frontman: 'no', competitor: 'yes', frontmanNote: 'Inspect a viewport in the browser preview', competitorNote: 'Arrange mobile, tablet, and desktop frames on one canvas' },
  { name: 'Bring your own AI account', frontman: 'yes', competitor: 'yes', frontmanNote: 'Supports Claude or ChatGPT sign-in and supported provider API keys', competitorNote: 'Connect Claude Code or ChatGPT/Codex' },
  { name: 'Source availability', frontman: 'yes', competitor: 'yes', frontmanNote: frontmanLicenseShort, competitorNote: 'Apache-2.0 source code; separate terms for some assets' },
]

const faqs: FAQ[] = [
  {
    question: 'Is Frontman an alternative to Onlook?',
    answer:
      'Yes, if you want to point at a rendered element and ask an agent to edit the source of an existing app. Choose Onlook if you want to arrange multiple views of your app on a desktop design canvas. Choose Frontman if you want to annotate elements in a browser preview connected to your app.',
  },
  {
    question: 'Can I use either tool with an existing project?',
    answer:
      'Yes. Onlook opens a local Git repository and starts the project’s dev server. Frontman connects through a supported integration such as Next.js, Astro, or Vite. Frontman includes the source file and line in an annotation when the integration can resolve them.',
  },
  {
    question: 'Do I need a desktop app or a separate AI account?',
    answer:
      'Onlook documents a macOS desktop download and asks you to connect Claude Code or ChatGPT/Codex for AI edits. Frontman runs its editing interface in the browser after you set up an integration. You can sign in with a supported Claude or ChatGPT account or connect a supported API key. AI provider costs are separate from Frontman Pro.',
  },
]
---

<ComparisonLayout
  seo={seo}
  competitor={competitor}
  review={review}
  heroTitle="Frontman vs Onlook"
  heroSubtitle="Browser annotations vs a desktop design canvas"
  features={features}
  faqs={faqs}
>
  <Fragment slot="hero-summary">
    <p class="summary-emphasis">
      Choose Onlook to compare layouts side by side on a desktop canvas. Choose Frontman to point at a specific element in your running app’s browser preview and ask for a source edit.
    </p>
    <p>
      Both tools can work on an existing codebase. This comparison covers <a href="https://github.com/onlook-dev/onlook#readme" class="text-link">Onlook’s current desktop app</a>, rather than its earlier web edition.
    </p>
  </Fragment>

  <Fragment slot="competitor-strengths">
    <p>Onlook opens a Git project and starts its dev server. You can arrange live mobile and desktop frames next to each other, then select a specific element and ask your connected agent to edit it.</p>
  </Fragment>

  <Fragment slot="frontman-differentiators">
    <p>
      In Frontman, you <a href="/docs/using/annotations/" class="text-link">annotate an element in the live preview</a>. Frontman sends the agent a screenshot and CSS selector. If your integration resolves the source location, it includes the file and line so the agent has a place to start.
    </p>
  </Fragment>

  <Fragment slot="who-should-use-competitor">
    <p>Use Onlook if your design review starts with several live views, such as comparing a checkout layout on mobile and desktop at the same time. Check the <a href="https://www.onlook.com/install" class="text-link">desktop install requirements</a> before choosing it.</p>
  </Fragment>

  <Fragment slot="who-should-use-frontman">
    <p>Use Frontman if you already have a page running and your feedback starts with a particular element, such as a button that wraps on mobile. <a href="/docs/reference/compatibility/" class="text-link">Check your framework integration</a> before setting up the browser preview.</p>
    <p>For another browser-based workflow, see <a href="/vs/stagewise/" class="text-link">Frontman vs Stagewise</a>.</p>
  </Fragment>
</ComparisonLayout>
